<template name="range-editor">
  <view class="row divider merchant-range" wx:for="{{ranges}}" wx:key="id">
    <picker class="grow" mode="time" value="{{item.from}}" data-field="{{field}}" data-index="{{index}}" data-side="from" bindchange="editRange">
      <view class="small muted">开始</view><view class="field">{{item.from}} ›</view>
    </picker>
    <picker class="grow" mode="time" value="{{item.to}}" data-field="{{field}}" data-index="{{index}}" data-side="to" bindchange="editRange">
      <view class="small muted">结束</view><view class="field">{{item.to}} ›</view>
    </picker>
    <button class="merchant-link" hover-class="merchant-link-pressed" data-field="{{field}}" data-index="{{index}}" bindtap="removeRange">移除</button>
  </view>
  <view wx:if="{{!ranges.length}}" class="muted action">暂无开放时段</view>
  <button wx:if="{{ranges.length < 4}}" class="merchant-link" hover-class="merchant-link-pressed" data-field="{{field}}" bindtap="addRange">＋ 添加一段</button>
</template>
