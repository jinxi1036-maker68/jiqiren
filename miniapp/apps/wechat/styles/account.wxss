.account-screen { color: #20342b; }
.hub-header { min-height: 76rpx; margin-bottom: 14rpx; }
.account-title { font-size: 44rpx; font-weight: 750; line-height: 1.2; letter-spacing: -.5rpx; }
.account-heading { font-size: 30rpx; font-weight: 720; line-height: 1.3; color: #213b30; }
.account-section { margin: 26rpx 0 12rpx; }
.account-paper { background: #fff; border: 1rpx solid #e1e8df; border-radius: 24rpx; padding: 24rpx; margin-bottom: 16rpx; }
.account-copy { color: #506359; font-size: 26rpx; line-height: 1.6; margin-top: 10rpx; overflow-wrap: break-word; }
.account-note { color: #627068; font-size: 23rpx; line-height: 1.5; margin-top: 12rpx; overflow-wrap: break-word; }
.account-link { background: transparent; color: #2d604a; min-height: 72rpx; padding: 0 8rpx 0 18rpx; font-weight: 660; }
.account-button { width: 100%; min-height: 88rpx; margin-top: 18rpx; }
.account-empty { padding: 40rpx 24rpx; }
.account-setting { padding: 18rpx 0; border-top: 1rpx solid #e9ede7; margin-top: 12rpx; }
.account-setting .account-note { margin-top: 4rpx; }
.account-step { display: flex; align-items: flex-start; gap: 16rpx; padding-top: 22rpx; margin-top: 22rpx; border-top: 1rpx solid #e7ece6; }
.account-step .account-copy { margin-top: 4rpx; }
.account-reply { padding: 16rpx; border-radius: 12rpx; background: #edf3eb; color: #325642; margin-top: 14rpx; overflow-wrap: break-word; }
.account-code { margin-top: 20rpx; background: #eef3ea; border-radius: 16rpx; padding: 12rpx 12rpx 12rpx 20rpx; }
.account-code > text { font-size: 36rpx; font-weight: 750; letter-spacing: 2rpx; }
.account-code button { background: #fff; padding: 0 14rpx; }
.login-paper { margin-top: 12rpx; padding: 32rpx; }
.login-paper .brand-logo { width: 80rpx; height: 80rpx; margin-bottom: 26rpx; font-size: 38rpx; }
.hub-identity {
  position: relative; overflow: hidden; isolation: isolate; padding: 28rpx; margin-bottom: 16rpx;
  border-radius: 26rpx; color: #fff; background: #183b2e;
}
.hub-art { position: absolute; right: -5rpx; bottom: -12rpx; width: 266rpx; height: 212rpx; }
.hub-identity-content, .hub-login { position: relative; z-index: 1; }
.hub-identity-content { gap: 18rpx; }
.hub-avatar { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 24rpx; background: #dbeaa0; color: #193b2d; font-size: 37rpx; font-weight: 750; }
.hub-name { font-size: 39rpx; font-weight: 750; line-height: 1.22; overflow-wrap: break-word; }
.hub-caption { color: #d2e2d6; font-size: 24rpx; margin-top: 5rpx; }
.hub-login { margin-top: 20rpx; background: #e5eeab; color: #1a3d2c; font-weight: 740; padding: 0 26rpx; gap: 14rpx; }
.hub-shortcuts { display: flex; gap: 5rpx; justify-content: space-between; padding: 8rpx 10rpx; }
.hub-shortcut { flex: 1; min-width: 0; position: relative; flex-direction: column; gap: 11rpx; min-height: 114rpx; padding: 12rpx 0; font-size: 23rpx; background: transparent; color: #244133; white-space: nowrap; }
.hub-shortcut .icon { width: 42rpx; height: 42rpx; }
.hub-shortcut-count { position: absolute; top: 7rpx; left: calc(50% + 16rpx); min-width: 25rpx; padding: 2rpx 3rpx; border-radius: 12rpx; font-size: 18rpx; background: #d9edc9; color: #244133; }
.hub-group { padding: 0 16rpx; }
.hub-cell { min-height: 92rpx; width: 100%; gap: 16rpx; justify-content: flex-start; border-radius: 0; background: transparent; color: #223b30; text-align: left; padding: 14rpx 4rpx; font-size: 28rpx; }
.hub-cell + .hub-cell { border-top: 1rpx solid #e8ede7; }
.hub-cell-description { color: #65736b; font-size: 23rpx; margin-top: 4rpx; }
.hub-arrow { color: #547160; font-size: 34rpx; }
.hub-return { margin-bottom: 16rpx; }
.campaign-banner { color: #243827; background: #e4edcb; border: 1rpx solid #d7e3bb; border-radius: 22rpx; padding: 20rpx; }
.campaign-entry { display: flex; justify-content: space-between; gap: 10rpx; width: 100%; text-align: left; margin-bottom: 16rpx; }
.campaign-label { color: #476039; font-size: 22rpx; font-weight: 670; }
.campaign-title { font-size: 32rpx; font-weight: 750; line-height: 1.2; margin-top: 7rpx; }
.campaign-arrow { display: flex; align-items: center; justify-content: center; border-radius: 30rpx; width: 60rpx; height: 60rpx; flex-shrink: 0; background: #f1f6dd; color: #395737; font-size: 38rpx; }
.campaign-hero { padding: 30rpx; }
.campaign-hero .campaign-title { font-size: 43rpx; margin-top: 12rpx; }
.campaign-copy { font-size: 25rpx; color: #435c43; margin-top: 12rpx; }
.offer { border-left: 6rpx solid #9eb78c; }
.discovery-heading { margin: 8rpx 0 4rpx; }
.discovery-card { display: block; width: 100%; min-height: 88rpx; padding: 22rpx; text-align: left; background: #fff; }
.discovery-card .site-thumb { width: 108rpx; height: 108rpx; border-radius: 16rpx; }
.discovery-card .availability { margin: 7rpx 0 4rpx; }
.discovery-card .muted { font-size: 24rpx; line-height: 1.45; }
.discovery-action { font-size: 24rpx; color: #2d604a; font-weight: 700; flex-shrink: 0; }
.discovery-action text { margin-left: 4rpx; font-size: 32rpx; }
.collector-next { border-left: 6rpx solid #6f9c78; }
