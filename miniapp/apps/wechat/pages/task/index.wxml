<import src="../../templates/site-guide.wxml"/>
<view class="screen collector-d1 {{missing ? '' : 'with-booking-dock'}}">
  <view class="panel" wx:if="{{missing}}">此任务已不可用。</view>
  <block wx:else>
    <view class="panel booking-overview">
      <view class="row">
        <view class="grow">
          <view class="title">{{task.title}}</view>
          <view class="muted">{{station.name}} · {{station.district}} {{station.address}}</view>
        </view>
        <image class="site-thumb" src="{{task.art}}" mode="aspectFill"/>
      </view>
      <view class="row split divider">
        <view class="price">¥{{card.rate}}<text class="price-unit">/ 有效小时 · 示例</text></view>
        <view class="muted">可约 {{task.min / 60}}<text wx:if="{{task.min !== task.max}}">–{{task.max / 60}}</text> 小时</view>
      </view>
    </view>
    <view class="panel">
      <view class="row split">
        <view class="heading">{{replaceId ? '选择改约时间' : '选择预约时间'}}</view>
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="date"><view class="filter-chip">{{date}} ›</view></picker>
      </view>
      <view class="muted action">门店开放 {{card.opening}}</view>
      <view class="notice" wx:if="{{selectionLost}}">原选时段已不可用，请重新选择。</view>
      <block wx:if="{{starts.length}}">
        <view class="divider">
          <view class="row d1-slot-heading"><text class="sop-step">1</text><view class="subheading">开始时间</view></view>
          <scroll-view class="slot-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="slot-row">
              <button wx:for="{{starts}}" wx:key="minute" class="slot {{item.minute === selectedStart ? 'slot-selected' : ''}}" data-minute="{{item.minute}}" bindtap="start">{{item.label}}</button>
            </view>
          </scroll-view>
        </view>
        <view class="divider">
          <view class="row d1-slot-heading">
            <text class="sop-step">2</text><view class="subheading grow">结束时间</view>
            <text wx:if="{{ends.length}}" class="muted small">最早 {{ends[0].label}}</text>
          </view>
          <view class="muted small action" wx:if="{{selectedStart === null}}">先选开始时间</view>
          <scroll-view wx:else class="slot-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="slot-row">
              <button wx:for="{{ends}}" wx:key="minute" class="slot {{item.minute === selectedEnd ? 'slot-selected' : ''}}" data-minute="{{item.minute}}" bindtap="end">{{item.label}}</button>
            </view>
          </scroll-view>
        </view>
      </block>
      <view class="notice" wx:else>{{card.availabilityReason}}，可切换日期。</view>
      <view class="row wrap divider" wx:if="{{reserved.length}}">
        <text class="muted small">已占用</text><text class="badge badge-muted" wx:for="{{reserved}}" wx:key="id">{{item.interval}}</text>
      </view>
      <input wx:if="{{lateChange}}" placeholder="距原预约不足2小时，请填写改期原因" bindinput="reason" value="{{reason}}"/>
    </view>
    <view class="panel booking-reference">
      <button class="d1-cell" hover-class="d1-pressed" bindtap="toggleGuide"><text class="grow">到店指引</text><text class="d1-arrow">{{showGuide ? '−' : '›'}}</text></button>
      <button class="d1-cell" hover-class="d1-pressed" bindtap="toggleSop"><text class="grow">采集要求</text><text class="d1-arrow">{{showSop ? '−' : '›'}}</text></button>
    </view>
    <template wx:if="{{showGuide}}" is="site-guide" data="{{guide: guide}}"/>
    <view wx:if="{{showSop}}" class="panel">
      <view class="heading">采集 SOP</view>
      <view class="muted small">只在示范区采集，避开顾客、未成年人和个人信息。</view>
      <view class="row divider sop-row" wx:for="{{task.steps}}" wx:key="*this"><text class="sop-step">{{index + 1}}</text><view class="grow">{{item}}</view></view>
      <view class="muted divider">设备 {{station.device.id}} · 每日上限 {{task.daily}} 分钟。按订单指引领机，结束后放回原箱并锁好。</view>
      <view class="muted small">相邻预约至少间隔30分钟，闭店前至少15分钟结束。</view>
    </view>
    <view class="dock booking-dock">
      <view class="row split booking-summary">
        <view class="muted small grow">{{date}} · {{station.name}}</view>
        <view class="subheading">{{selectionText}}</view>
      </view>
      <button class="primary" disabled="{{!canConfirm}}" hover-class="d1-primary-pressed" bindtap="submit">{{replaceId ? '确认模拟改约' : '确认模拟预约'}}</button>
    </view>
  </block>
</view>
