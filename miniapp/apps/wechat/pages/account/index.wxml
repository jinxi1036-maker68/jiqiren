<view class="screen account-screen {{role === 'collector' ? 'collector-d1' : ''}}">
  <block wx:if="{{view === 'login'}}">
    <view class="account-paper login-paper">
      <view class="brand-logo">凌</view>
      <view class="account-title">登录凌矩</view>
      <view class="account-copy">以{{account.merchant ? '商家' : '采集员'}}身份体验，管理本机的{{account.merchant ? '服务记录' : '活动、券和邀请'}}。</view>
      <view class="account-note">演示账号 {{account.name}} · 信息仅保存在本机</view>
      <button class="primary account-button" hover-class="control-pressed" bindtap="login">一键演示登录</button>
    </view>
  </block>

  <block wx:elif="{{view === 'benefits'}}">
    <view class="campaign-banner campaign-hero">
      <view class="campaign-label">新手采集计划 · 演示</view>
      <view class="campaign-title">新人体验券和首单礼</view>
      <view class="campaign-copy">先领新人券，完成有效采集后领取首单礼。</view>
    </view>
    <view class="row split account-section"><view class="account-heading">可参与的活动</view><button class="account-link" data-view="coupons" bindtap="openAccount">我的券 ›</button></view>
    <view class="account-paper offer" wx:for="{{offers}}" wx:key="id">
      <view class="row split"><view class="account-heading">{{item.title}}</view><text class="status-pill status-quiet">{{item.label}}</text></view>
      <view class="account-copy">{{item.detail}}</view>
      <view wx:if="{{item.claimed}}" class="account-note">已领取 · 可在「我的券」查看</view>
      <button wx:elif="{{!account.loggedIn}}" class="primary account-button" data-view="login" bindtap="openAccount">登录后参与</button>
      <button wx:elif="{{item.eligible}}" class="primary account-button" data-id="{{item.id}}" bindtap="claimCoupon">领取演示券</button>
      <button wx:else class="ghost account-button" bindtap="findTasks">去预约采集</button>
    </view>
    <view class="account-note">活动和券供体验使用，正式奖励规则待发布。</view>
  </block>

  <block wx:elif="{{view === 'coupons'}}">
    <view class="row split account-section"><view class="account-heading">已领 {{account.coupons.length}} 张</view><button class="account-link" data-view="benefits" bindtap="openAccount">去领券 ›</button></view>
    <view class="account-paper offer" wx:for="{{account.coupons}}" wx:key="id">
      <view class="row split"><view class="account-heading">{{item.title}}</view><text class="status-pill status-ready">已领取</text></view>
      <view class="account-copy">领取时间 {{item.time}}</view>
      <view class="account-note">模拟券 · 当前用于查看权益记录</view>
    </view>
    <view wx:if="{{!account.coupons.length}}" class="account-paper account-empty"><view class="account-heading">这里还没有券</view><view class="account-copy">在福利活动领取后，记录会显示在这里。</view></view>
  </block>

  <block wx:elif="{{view === 'invite'}}">
    <view class="account-paper">
      <view class="account-title">邀请好友来采集</view>
      <view class="account-copy">好友在首次预约前填入邀请码，完成采集并通过设备核验和有效时长质检后，可记录演示奖励。</view>
      <view class="account-note">邀请关系与奖励记录保存在同一台体验设备。正式返现条件和金额待确认。</view>
      <view class="account-code row split"><text>{{invite.code}}</text><button class="ghost touch-control" bindtap="copyCode">复制演示邀请码</button></view>
    </view>
    <view class="account-paper">
      <view class="account-heading">填写好友邀请码</view>
      <view wx:if="{{invite.incoming}}" class="account-note">已记录邀请人 {{invite.incoming}}</view>
      <view wx:elif="{{!invite.canBind}}" class="account-note">仅在首次预约或发起邀请前可填写。</view>
      <button wx:elif="{{!account.loggedIn}}" class="ghost account-button" data-view="login" bindtap="openAccount">登录后填写</button>
      <block wx:else>
        <input class="field" placeholder="例如 LJ-C1" value="{{code}}" maxlength="12" bindinput="editCode"/>
        <button class="primary account-button" disabled="{{!code}}" bindtap="bindInvite">确认邀请码</button>
      </block>
    </view>
    <view class="account-heading account-section">邀请进度</view>
    <view class="account-paper" wx:for="{{invite.outgoing}}" wx:key="id">
      <view class="row split"><view class="subheading">{{item.name}}</view><text class="status-pill status-{{item.rewardedAt ? 'ready' : 'quiet'}}">{{item.label}}</text></view>
      <button wx:if="{{item.canClaim && account.loggedIn}}" class="primary account-button" data-id="{{item.id}}" bindtap="claimInvite">记录演示奖励</button>
    </view>
    <view wx:if="{{!invite.outgoing.length}}" class="account-paper account-copy">有好友在本机填入你的邀请码后，进度会显示在这里。</view>
  </block>

  <block wx:elif="{{view === 'feedback'}}">
    <view class="account-paper">
      <view class="account-heading">告诉凌矩遇到了什么</view>
      <view class="account-copy">订单现场问题可在原订单求助。这里收集使用建议、投诉和功能问题。</view>
      <picker range="{{topics}}" value="{{topicIndex}}" bindchange="topic"><view class="field row split"><text>{{topics[topicIndex]}}</text><text>›</text></view></picker>
      <textarea value="{{message}}" bindinput="message" maxlength="200" placeholder="请用示例内容描述问题和期望的处理方式"/>
      <view class="account-note">{{message.length}} / 200 字</view>
      <button class="primary account-button" disabled="{{!canSend}}" bindtap="sendFeedback">提交模拟反馈</button>
    </view>
    <view class="account-heading account-section">我的反馈</view>
    <view class="account-paper" wx:for="{{account.feedback}}" wx:key="id">
      <view class="row split"><view class="subheading">{{item.topic}}</view><text class="status-pill status-{{item.reply ? 'ready' : 'wait'}}">{{item.reply ? '已回复' : '待处理'}}</text></view>
      <view class="account-copy">{{item.message}}</view><view class="account-note">{{item.id}} · {{item.time}}</view>
      <view wx:if="{{item.reply}}" class="account-reply">凌矩回复　{{item.reply}}</view>
    </view>
    <view wx:if="{{!account.feedback.length}}" class="account-paper account-copy">提交后可以在这里查看进度和回复。</view>
  </block>

  <block wx:elif="{{view === 'guide'}}">
    <view class="account-paper">
      <view class="account-title">{{account.merchant ? '门店怎么开设采集站' : '一笔采集怎么完成'}}</view>
      <view class="account-copy">凌矩提供站点运营和设备核验，采集员按订单在开放时段内自助完成采集。</view>
      <view class="account-step" wx:for="{{steps}}" wx:key="title">
        <text class="sop-step">{{index + 1}}</text><view class="grow"><view class="subheading">{{item.title}}</view><view class="account-copy">{{item.detail}}</view></view>
      </view>
    </view>
    <button class="ghost account-button" data-role="{{role}}" data-view="feedback" bindtap="openAccount">需要帮助 · 投诉建议</button>
  </block>

  <block wx:elif="{{view === 'about'}}">
    <view class="account-paper">
      <view class="brand-logo">凌</view>
      <view class="account-title">凌矩共享采集站</view>
      <view class="account-copy">让门店在可开放的时间里提供采集场地，让个人采集员找到站点、预约设备、自助完成任务。凌矩负责现场运营、设备核验和异常处理。</view>
      <view class="account-note">模拟体验 · 本机数据</view>
      <button class="ghost account-button" data-role="{{role}}" data-view="guide" bindtap="openAccount">了解服务流程</button>
    </view>
  </block>

  <block wx:elif="{{view === 'settings'}}">
    <view class="account-paper">
      <view class="account-heading">账号与偏好</view>
      <view class="row split account-setting"><view><view>当前演示身份</view><view class="account-note">{{account.name}}</view></view><text class="status-pill status-quiet">{{account.loggedIn ? '已登录' : '未登录'}}</text></view>
      <view wx:if="{{!account.merchant}}" class="row split account-setting"><view class="grow"><view>首页推荐福利活动</view><view class="account-note">控制首页轮播里的福利卡片</view></view><switch checked="{{account.showCampaign}}" color="#1e3d68" bindchange="campaignSetting"/></view>
      <button wx:if="{{account.loggedIn}}" class="ghost account-button" bindtap="logout">退出演示登录</button>
      <button wx:else class="primary account-button" data-role="{{role}}" data-view="login" bindtap="openAccount">点击登录</button>
    </view>
  </block>

  <block wx:elif="{{view === 'credit'}}">
    <view class="account-paper">
      <view class="row split"><view class="account-heading">信誉分</view><text class="status-pill status-quiet">{{credit.label}}</text></view>
      <view class="metric action">{{credit.score}} / 100</view>
      <view class="account-copy">每满30天无核实的本人违规恢复1分，最高100分。</view>
      <view class="account-note">已确认预约可按原安排履行。</view>
      <view class="notice" wx:if="{{credit.review.decision}}">{{credit.review.decision.reason}}</view>
    </view>
    <view class="account-paper" wx:for="{{credit.events}}" wx:key="id">
      <view class="row split"><view class="subheading">{{item.fault ? '超时归还核实' : '非本人责任'}}</view><text class="status-pill status-quiet">{{item.reversed ? '已纠正' : '扣 ' + item.points + ' 分'}}</text></view>
      <view class="account-copy">{{item.reason}}</view><view class="account-note">{{item.time}} · {{item.orderId}}</view>
      <view wx:if="{{item.appeal}}" class="notice">{{item.appeal.status === 'pending' ? '申诉复核中' : item.appeal.decision.reason}}</view>
      <button wx:if="{{item.canAppeal}}" class="ghost account-button" data-id="{{item.id}}" bindtap="appeal">提交模拟申诉</button>
    </view>
    <view wx:if="{{!credit.events.length}}" class="account-paper account-copy">暂无经运营核实的信誉事件。</view>
  </block>
  <view class="tagline">凌矩共享采集站 · 演示体验</view>
</view>
