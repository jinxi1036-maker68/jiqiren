<view class="screen">
  <view class="panel" wx:if="{{!allowed}}">
    <view class="heading">内部演示入口</view>
    <view class="muted">请在微信开发者工具通过「凌矩模拟运营」编译模式启动。</view>
    <button class="action" bindtap="home">返回身份选择</button>
  </view>
  <block wx:else>
    <view class="hero">
      <view class="kicker">内部调试 · 全部为模拟操作</view>
      <view class="title">凌矩运营工作台</view>
      <view class="muted">模拟北京时间 {{now}} · 本机数据</view>
    </view>
    <view class="row">
      <button class="grow ghost" data-role="merchant" bindtap="viewRole">查看商家端</button>
      <button class="grow ghost" data-role="collector" bindtap="viewRole">查看采集员端</button>
    </view>
    <view class="row wrap tabs">
      <button class="{{section === 'work' ? 'primary' : ''}}" data-section="work" bindtap="section">今日待办</button>
      <button class="{{section === 'sites' ? 'primary' : ''}}" data-section="sites" bindtap="section">场地</button>
      <button class="{{section === 'orders' ? 'primary' : ''}}" data-section="orders" bindtap="section">设备订单</button>
      <button class="{{section === 'reviews' ? 'primary' : ''}}" data-section="reviews" bindtap="section">审核</button>
      <button class="{{section === 'feedback' ? 'primary' : ''}}" data-section="feedback" bindtap="section">用户反馈</button>
      <button class="{{section === 'logs' ? 'primary' : ''}}" data-section="logs" bindtap="section">时钟审计</button>
    </view>
    <block wx:if="{{section === 'work'}}">
      <view class="panel">
        <view class="row split"><view class="heading">今日待办</view><text class="badge">{{work.length}} 项</text></view>
        <view class="muted action">包含未结事项，优先显示逾期归还和暂停接单的设备。</view>
      </view>
      <view class="panel row split" wx:for="{{work}}" wx:key="target">
        <view class="grow"><view class="subheading">{{item.label}}</view><view class="muted">{{item.detail}}</view></view>
        <button class="ghost subtle-button" data-section="{{item.section}}" data-target="{{item.target}}" bindtap="openWork">查看</button>
      </view>
      <view class="panel muted" wx:if="{{!work.length}}">暂无需要处理的事项。</view>
    </block>
    <block wx:if="{{section === 'feedback'}}">
      <view class="heading section">用户反馈</view>
      <view class="panel" wx:for="{{feedback}}" wx:key="id" id="feedback-{{item.id}}">
        <view class="row split"><view class="subheading">{{item.topic}}</view><text class="status-pill status-{{item.reply ? 'ready' : 'wait'}}">{{item.reply ? '已回复' : '待处理'}}</text></view>
        <view class="muted">{{item.name}} · {{item.time}}</view>
        <view class="account-copy">{{item.message}}</view>
        <view wx:if="{{item.reply}}" class="account-reply">{{item.reply}}</view>
        <button wx:else class="ghost action touch-control" data-id="{{item.id}}" data-action="feedback" bindtap="act">回复反馈</button>
      </view>
      <view wx:if="{{!feedback.length}}" class="panel muted">暂无用户反馈。</view>
    </block>
    <block wx:if="{{section === 'sites'}}">
      <view class="panel" wx:for="{{sites}}" wx:key="id" id="site-{{item.id}}">
        <view class="row split"><view class="subheading">{{item.name}}</view><view class="badge">{{item.label}}</view></view>
        <view class="muted">{{item.district}} {{item.address}}</view>
        <view class="divider" wx:if="{{item.application}}">
          <view>{{item.application.contact}} · {{item.application.phone}}</view>
          <view class="muted">模拟门头、室内、设备位置照片已提交。</view>
          <view class="muted" wx:if="{{item.guide}}">{{item.guide.entrance}} {{item.guide.locker}} {{item.guide.area}}</view>
          <view class="muted" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
        <view class="row wrap action" wx:if="{{item.stage === 'review'}}">
          <button class="primary" data-action="site" data-id="{{item.id}}" data-result="approved" bindtap="act">模拟通过</button>
          <button data-action="site" data-id="{{item.id}}" data-result="supplement" bindtap="act">补资料</button>
          <button class="danger" data-action="site" data-id="{{item.id}}" data-result="rejected" bindtap="act">暂不通过</button>
        </view>
        <button class="action" wx:if="{{item.stage === 'approved'}}" data-action="install" data-id="{{item.id}}" bindtap="act">登记设备安装</button>
        <view class="divider" wx:if="{{item.stage === 'open'}}">
          <view>{{item.taskName}} · {{item.taskEnabled ? '可展示' : '已暂停'}}</view>
          <button class="action" data-action="task" data-id="{{item.id}}" bindtap="act">{{item.taskEnabled ? '暂停任务新预约' : '开放模拟任务'}}</button>
        </view>
      </view>
    </block>
    <block wx:if="{{section === 'orders'}}">
      <view class="section heading">设备</view>
      <view class="panel" wx:for="{{sites}}" wx:key="id" wx:if="{{item.device}}" id="device-{{item.id}}">
        <view class="row split"><view class="subheading">{{item.device.id}}</view><view class="badge">{{item.paused ? '暂停接单' : '可用'}}</view></view>
        <view class="muted">{{item.name}} {{item.device.fault.reason}}</view>
        <button wx:if="{{item.paused}}" class="action" data-action="reopen" data-id="{{item.id}}" bindtap="act">模拟核验可用并复开</button>
        <button wx:else class="action" data-action="pause" data-id="{{item.id}}" bindtap="act">核实故障并暂停</button>
      </view>
      <view class="section heading">待处理订单求助</view>
      <view class="panel" wx:for="{{reports}}" wx:key="id" id="report-{{item.id}}">
        <view class="subheading">{{item.orderId}} · {{item.type}}</view>
        <view>{{item.details}}</view>
        <view class="muted">{{item.time}} · {{item.samplePhoto ? '附模拟现场照片占位' : '无照片'}}</view>
        <view class="row wrap action">
          <button data-action="resolve" data-id="{{item.id}}" bindtap="act">回复并结案</button>
          <button wx:if="{{item.deviceIssue}}" data-action="pause" data-id="{{item.stationId}}" data-report="{{item.id}}" bindtap="act">核实故障并暂停</button>
        </view>
      </view>
      <view class="panel muted" wx:if="{{!reports.length}}">暂无待处理求助。</view>
      <view class="section heading">订单</view>
      <view class="panel" wx:for="{{orders}}" wx:key="id" id="order-{{item.id}}">
        <view class="row split"><view class="subheading">{{item.id}} · {{item.collectorId}}</view><view class="badge">{{item.stateLabel}}</view></view>
        <view>{{item.stationName}}</view><view class="muted">{{item.interval}}</view>
        <button wx:if="{{item.status === 'submitted'}}" class="primary action" data-action="return" data-id="{{item.id}}" bindtap="act">模拟核验归还</button>
        <button wx:if="{{item.canOpsCancel}}" class="danger action" data-action="cancel" data-id="{{item.id}}" bindtap="act">核查风险并逐单取消</button>
      </view>
      <view class="panel muted" wx:if="{{!orders.length}}">等待采集员提交模拟预约。</view>
    </block>
    <block wx:if="{{section === 'reviews'}}">
      <view class="section heading">质检待办</view>
      <view class="panel" wx:for="{{qa}}" wx:key="id" id="qa-{{item.id}}">
        <view class="subheading">{{item.id}} · 实采 {{item.actual}} 分钟</view>
        <view wx:if="{{item.qaAppeal}}" class="muted">{{item.qaAppeal.reason}} · 原有效 {{item.qa.valid}} 分钟</view>
        <button class="action" data-action="{{item.qaPending ? 'qa' : 'qaAppeal'}}" data-id="{{item.id}}" bindtap="act">{{item.qaPending ? '录入模拟QA' : '模拟QA复核'}}</button>
      </view>
      <view class="panel muted" wx:if="{{!qa.length}}">暂无待审或待复核的质检。</view>
      <view class="section heading">交通补贴</view>
      <view class="panel">
        <view class="row split"><view>虚构金额 ¥{{price}} · V{{priceVersion}}</view><switch color="#17634e" checked="{{lead}}" bindchange="lead"/></view>
        <view class="muted">开关用于模拟运营负责人。新金额只作用于新申请。</view>
        <button wx:if="{{lead}}" class="action" data-action="price" bindtap="act">调整虚构金额</button>
      </view>
      <view class="panel" wx:for="{{subsidies}}" wx:key="id" id="subsidy-{{item.id}}">
        <view class="subheading">{{item.id}} · {{item.subsidyStatus}}</view>
        <view>¥{{item.subsidyAmount}}（虚构） · 凭证 {{item.subsidy.proof === 'route' ? '模拟行程' : '模拟到店'}}</view>
        <view class="muted">{{item.cancellation.outage.reason}} · 截止 {{item.subsidyDue}}</view>
        <view wx:if="{{item.subsidy.appeal}}" class="muted">补充证据 {{item.subsidy.appeal.proof}}</view>
        <view class="row action">
          <button class="grow primary" data-action="subsidy" data-id="{{item.id}}" data-result="yes" bindtap="act">模拟核验通过</button>
          <button class="grow danger" data-action="subsidy" data-id="{{item.id}}" data-result="no" bindtap="act">拒绝并说明</button>
        </view>
      </view>
      <view class="section heading">信誉与接单资格</view>
      <view class="panel" wx:for="{{penalties}}" wx:key="id">
        <view class="subheading">{{item.id}} · 待核查归还逾期</view>
        <view class="muted">核实实际归还时间和责任，再决定是否计分。</view>
        <view class="row wrap action">
          <button data-action="credit" data-id="{{item.id}}" data-result="exempt" bindtap="act">核实免责</button>
          <button data-action="credit" data-id="{{item.id}}" data-result="fault" bindtap="act">核实本人责任</button>
          <button wx:if="{{item.creditImpact}}" data-action="credit" data-id="{{item.id}}" data-result="impact" bindtap="act">核实下位受影响</button>
        </view>
      </view>
      <view class="panel" wx:for="{{credits}}" wx:key="id">
        <view class="subheading">{{item.orderId}} · 信誉申诉</view>
        <view>{{item.appeal.reason}}</view><view class="muted">截止 {{item.due}}</view>
        <view class="row action">
          <button class="grow primary" data-action="creditAppeal" data-id="{{item.id}}" data-result="yes" bindtap="act">模拟纠正扣分</button>
          <button class="grow danger" data-action="creditAppeal" data-id="{{item.id}}" data-result="no" bindtap="act">不通过</button>
        </view>
      </view>
      <view class="panel" wx:for="{{people}}" wx:key="id">
        <view class="row split"><view>{{item.name}} · {{item.score}} 分</view><view class="badge">{{item.label}}</view></view>
        <block wx:if="{{item.review.status === 'pending'}}">
          <view class="muted">资格审核截止 {{item.due}}</view>
          <view class="row action">
            <button class="grow primary" data-action="eligibility" data-id="{{item.id}}" data-result="yes" bindtap="act">模拟恢复资格</button>
            <button class="grow danger" data-action="eligibility" data-id="{{item.id}}" data-result="no" bindtap="act">保持限制</button>
          </view>
        </block>
      </view>
    </block>
    <block wx:if="{{section === 'logs'}}">
      <view class="panel">
        <view class="heading">模拟时钟</view>
        <view class="muted">推进后计算预约提醒、逾期告警及信誉恢复。</view>
        <view class="row wrap action">
          <button data-delta="15" bindtap="jump">＋15 分钟</button>
          <button data-delta="1440" bindtap="jump">＋1 天</button>
          <button data-delta="43200" bindtap="jump">＋30 天</button>
        </view>
      </view>
      <view class="panel">
        <view class="heading">运营告警</view>
        <view class="divider" wx:for="{{messages}}" wx:key="key">
          <view>{{item.title}} · {{item.orderId}}</view><view class="muted">{{item.time}} {{item.text}}</view>
        </view>
        <view class="muted" wx:if="{{!messages.length}}">暂无告警。</view>
      </view>
      <view class="panel">
        <view class="heading">最近操作记录</view>
        <view class="divider" wx:for="{{audit}}" wx:key="id">
          <view>{{item.action}} · {{item.target}}</view><view class="muted">{{item.time}} · {{item.actor}}</view><view>{{item.detail}}</view>
        </view>
        <view class="muted" wx:if="{{!audit.length}}">暂无记录。</view>
      </view>
    </block>
    <view class="tagline">凌矩内部调试 · 无实际审核或资金操作</view>
  </block>
</view>
