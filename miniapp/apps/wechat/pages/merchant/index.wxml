<import src="../../templates/range-editor.wxml"/>
<view class="screen {{deployed ? 'with-dock' : ''}}">
  <view class="row split">
    <view class="row brand-lockup"><view class="brand-logo">凌</view><text>商家工作台</text></view>
    <button class="ghost subtle-button" bindtap="switchRole">切换身份</button>
  </view>
  <picker mode="selector" range="{{sites}}" value="{{siteIndex}}" bindchange="persona">
    <view class="panel row split action">
      <view class="row grow"><image class="icon" src="/assets/icons/store.svg" mode="aspectFit"/><view class="subheading">{{station.name}}</view></view>
      <text class="muted small">切换门店 ›</text>
    </view>
  </picker>
  <block wx:if="{{!deployed}}">
    <view class="hero">
      <view class="row split"><view class="kicker">场地合作 · 模拟体验</view><view class="badge">{{stage}}</view></view>
      <view class="title">设备入驻</view>
      <view class="muted">申请一台设备，让采集员在你开放的时间到店采集。</view>
      <view class="stage-grid">
        <view wx:for="{{steps}}" wx:key="*this" class="stage-item {{index === step ? 'stage-current' : index < step ? 'stage-past' : ''}}">
          <view class="stage-bar"/>{{item}}
        </view>
      </view>
    </view>
    <view class="panel merchant-action">
      <view class="eyebrow">下一步</view>
      <view class="merchant-next">{{nextTitle}}</view>
      <view class="muted">{{nextHint}}</view>
      <view class="notice" wx:if="{{station.note}}">{{station.note}}</view>
      <button wx:if="{{canApply && !showApplication}}" class="primary action" bindtap="openApplication">{{station.stage === 'draft' ? '开始申请' : '完善申请资料'}}</button>
      <button wx:if="{{station.stage === 'installed'}}" class="primary action" bindtap="confirm">确认模拟设备到位</button>
    </view>
    <view class="panel" wx:if="{{canApply && showApplication}}" id="merchant-apply">
      <view class="heading">场地申请</view>
      <view class="notice">请使用预填的虚构资料。照片使用本地占位。</view>
      <picker range="{{districts}}" value="{{districtIndex}}" bindchange="district">
        <view class="field row split"><text>所在区域</text><text>{{city}} · {{districts[districtIndex]}} ›</text></view>
      </picker>
      <block wx:for="{{fields}}" wx:key="key">
        <view class="muted">{{item.label}}</view>
        <input value="{{form[item.key]}}" maxlength="45" data-key="{{item.key}}" bindinput="field"/>
      </block>
      <picker range="{{categories}}" value="{{taskIndex}}" bindchange="category">
        <view class="field row split"><text>经营类型</text><text>{{categories[taskIndex]}} ›</text></view>
      </picker>
      <view class="row">
        <button class="grow photo-choice {{added[item.id] ? 'slot-selected' : 'ghost'}}" wx:for="{{photos}}" wx:key="id" data-id="{{item.id}}" bindtap="photo">
          <text class="photo-sign">{{added[item.id] ? '✓' : '+'}}</text><text>{{item.title}}</text>
        </button>
      </view>
      <button class="primary action" bindtap="apply">提交模拟入驻申请</button>
    </view>
  </block>
  <block wx:else>
    <view class="hero">
      <view class="row split"><view class="kicker">门店运营 · 模拟体验</view><view class="badge">{{deviceLabel}}</view></view>
      <view class="title">{{station.stage === 'schedule' ? '设置开放时间' : '今日概览'}}</view>
      <view class="muted">{{station.device.id}} · 北京时间 {{now}}</view>
    </view>
    <block wx:if="{{section === 'home'}}">
      <view class="panel">
        <view class="row split"><view class="subheading">{{station.device.id}}</view><view class="badge">{{deviceLabel}}</view></view>
        <view class="muted">{{city}} · {{station.district}} · {{station.address}}</view>
        <view class="muted">采集员在订单内自助领还。归还核验由凌矩处理。</view>
        <view class="row divider">
          <view class="grow tile"><view class="metric">{{todayOrders}}</view><view class="muted">今日预约</view></view>
          <view class="grow tile"><view class="metric">{{daily}}</view><view class="muted">今日确认收益笔数</view></view>
        </view>
      </view>
      <view class="panel">
        <view class="heading">设备排班</view>
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="selectDate">
          <view class="field">{{date}}　{{windowLabel}} ›</view>
        </picker>
        <view class="muted">相邻预约预留30分钟，采集结束距当段闭店至少15分钟。</view>
        <view class="divider" wx:for="{{orders}}" wx:key="id">
          <view class="row split"><text>{{item.interval}}</text><text class="badge">{{item.stateLabel}}</text></view>
          <view class="muted">{{item.id}} · {{item.taskName}}</view>
        </view>
        <view wx:if="{{!orders.length}}" class="divider muted">该日暂无预约。</view>
      </view>
    </block>
    <block wx:if="{{section === 'schedule'}}">
      <view class="panel">
        <view class="heading">每周开放计划</view>
        <view class="muted">每天最多四段。移除全部时段后，该星期几暂停。</view>
        <picker range="{{days}}" value="{{weekday}}" bindchange="weekday"><view class="field">{{days[weekday]}} ›</view></picker>
        <template is="range-editor" data="{{ranges: weekRanges, field: 'weekRanges'}}"/>
        <button class="primary action" bindtap="saveWeek">预览周计划变更</button>
      </view>
      <view class="panel">
        <view class="heading">指定日期调整</view>
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="selectDate">
          <view class="field">{{date}}　{{windowLabel}} ›</view>
        </picker>
        <template is="range-editor" data="{{ranges: dayRanges, field: 'dayRanges'}}"/>
        <button class="primary action" bindtap="saveDate">预览单日变更</button>
        <view class="row action">
          <button class="grow danger" bindtap="pauseDate">暂停当日</button>
          <button class="grow ghost" bindtap="restoreDate">恢复周计划</button>
        </view>
      </view>
      <view wx:if="{{scheduleReview}}" class="panel" id="schedule-review">
        <view class="heading">{{scheduleReview.title}}</view>
        <view class="muted">{{scheduleReview.site}} · {{scheduleReview.hours}}</view>
        <view class="notice">将新增影响 {{scheduleReview.orders.length}} 笔预约</view>
        <view class="divider" wx:for="{{scheduleReview.orders}}" wx:key="id">
          <view class="row split"><text>{{item.id}} · {{item.interval}}</text><text class="badge">{{item.stateLabel}}</text></view>
          <view class="muted">{{item.impactText}}</view>
        </view>
        <view class="row action">
          <button class="grow ghost" bindtap="cancelSchedule">返回编辑</button>
          <button class="grow primary" bindtap="confirmSchedule">确认变更</button>
        </view>
      </view>
    </block>
    <view class="panel" wx:if="{{section === 'income'}}">
      <view class="heading">自然月场地账目</view>
      <picker mode="date" fields="month" value="{{period}}" bindchange="selectPeriod"><view class="field">{{period}} ›</view></picker>
      <view class="muted">模拟实际采集且核验归还后计入待结算。金额及结算日待协议确认。</view>
      <view class="divider" wx:for="{{currentEarnings}}" wx:key="id">
        <view class="row split"><text>{{item.orderId}} · {{item.kindLabel}}</text><text class="badge">{{item.state}}</text></view>
        <view class="muted">{{item.amount}}</view>
      </view>
      <view wx:if="{{!currentEarnings.length}}" class="divider muted">本月暂无确认账目。</view>
    </view>
    <view class="dock dock-nav">
      <button wx:for="{{navItems}}" wx:key="section" class="dock-item {{section === item.section ? 'is-active' : ''}}" data-section="{{item.section}}" bindtap="section">
        <view class="dock-mark"><image class="icon" src="{{item.icon}}" mode="aspectFit"/></view>
        <text>{{item.label}}</text>
      </button>
    </view>
  </block>
  <view class="tagline">演示数据 · 仅保存在当前设备</view>
</view>
