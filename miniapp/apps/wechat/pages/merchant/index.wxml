<import src="../../templates/range-editor.wxml"/>
<import src="../../templates/account-hub.wxml"/>
<view class="screen {{deployed ? 'with-dock' : ''}}">
  <view class="row split" wx:if="{{section !== 'profile'}}">
    <view class="row brand-lockup"><view class="brand-logo">凌</view><text>商家工作台</text></view>
    <view class="row">
      <button wx:if="{{!deployed}}" class="ghost subtle-button" data-section="profile" bindtap="section">我的</button>
      <button class="ghost subtle-button" hover-class="control-pressed" bindtap="switchRole">切换身份</button>
    </view>
  </view>
  <picker wx:if="{{section !== 'profile'}}" mode="selector" range="{{sites}}" value="{{siteIndex}}" bindchange="persona">
    <view class="panel row split action merchant-site">
      <view class="row grow">
        <image class="icon" src="/assets/icons/store.svg" mode="aspectFit"/>
        <view class="grow"><view class="subheading">{{station.name}}</view><view wx:if="{{station.address}}" class="muted small">{{station.district}} · {{station.address}}</view></view>
      </view>
      <text class="muted small">切换门店 ›</text>
    </view>
  </picker>
  <template wx:if="{{section === 'profile'}}" is="account-hub" data="{{account: account, deployed: deployed}}"/>
  <block wx:elif="{{!deployed}}">
    <view class="hero">
      <view class="row split"><view class="kicker">场地合作 · 模拟体验</view><view class="badge">{{stage}}</view></view>
      <view class="title">设备入驻</view>
      <view class="muted">申请一台设备，让采集员在你开放的时间到店采集。</view>
      <view class="stage-grid">
        <view wx:for="{{steps}}" wx:key="*this" class="stage-item {{index === step ? 'stage-current' : index < step ? 'stage-past' : ''}}">
          <view class="stage-bar"/>{{item}}
        </view>
      </view>
    </view>
    <view class="panel merchant-action">
      <view class="eyebrow">下一步</view>
      <view class="merchant-next">{{nextTitle}}</view>
      <view class="muted">{{nextHint}}</view>
      <view class="notice" wx:if="{{station.note}}">{{station.note}}</view>
      <button wx:if="{{canApply && !showApplication}}" class="primary action" bindtap="openApplication">{{station.stage === 'draft' ? '开始申请' : '完善申请资料'}}</button>
      <button wx:if="{{station.stage === 'installed'}}" class="primary action" bindtap="confirm">确认模拟设备到位</button>
    </view>
    <view class="panel" wx:if="{{canApply && showApplication}}" id="merchant-apply">
      <view class="heading">场地申请</view>
      <view class="notice">请使用预填的虚构资料。照片使用本地占位。</view>
      <picker range="{{districts}}" value="{{districtIndex}}" bindchange="district">
        <view class="field row split"><text>所在区域</text><text>{{city}} · {{districts[districtIndex]}} ›</text></view>
      </picker>
      <block wx:for="{{fields}}" wx:key="key">
        <view class="muted">{{item.label}}</view>
        <input value="{{form[item.key]}}" maxlength="45" data-key="{{item.key}}" bindinput="field"/>
      </block>
      <picker range="{{categories}}" value="{{taskIndex}}" bindchange="category">
        <view class="field row split"><text>经营类型</text><text>{{categories[taskIndex]}} ›</text></view>
      </picker>
      <view class="row">
        <button class="grow photo-choice {{added[item.id] ? 'slot-selected' : 'ghost'}}" wx:for="{{photos}}" wx:key="id" data-id="{{item.id}}" bindtap="photo">
          <text class="photo-sign">{{added[item.id] ? '✓' : '+'}}</text><text>{{item.title}}</text>
        </button>
      </view>
      <button class="primary action" bindtap="apply">提交模拟入驻申请</button>
    </view>
  </block>
  <block wx:else>
    <block wx:if="{{section === 'home'}}">
      <view class="panel merchant-overview">
        <view class="row split">
          <view class="kicker">今日概览 · 模拟</view>
          <text class="status-pill status-{{overview.opening.tone}}">{{overview.opening.label}}</text>
        </view>
        <view class="merchant-visit">
          <block wx:if="{{overview.next}}">
            <view class="kicker">{{overview.nextLabel}}</view>
            <view class="merchant-time">{{overview.next.startTime}}<text class="merchant-time-end">–{{overview.next.endTime}}</text></view>
            <view class="muted">{{overview.next.taskName}} · {{overview.next.stateLabel}}</view>
          </block>
          <view wx:else class="heading">{{overview.nextLabel}}</view>
        </view>
        <view class="merchant-context">
          <view class="row split"><view class="muted">设备状态</view><text class="status-pill status-{{overview.device.tone}}">{{overview.device.label}}</text></view>
          <view class="row split"><view class="muted">今日开放时段</view><view class="merchant-hours">{{overview.hours}}</view></view>
        </view>
        <view wx:if="{{overview.device.note || overview.affected}}" class="notice">
          {{overview.device.note}}<view wx:if="{{overview.affected}}">今日 {{overview.affected}} 笔预约受影响，可在下方排班查看。</view>
        </view>
        <view class="row action merchant-actions">
          <button class="grow primary touch-control" hover-class="control-pressed" bindtap="showTodaySchedule">查看今日排班</button>
          <button class="grow ghost touch-control" hover-class="control-pressed" data-section="schedule" bindtap="section">调整开放时间</button>
        </view>
      </view>
      <view class="panel row merchant-totals">
        <view class="grow"><view class="metric">{{todayOrders}}<text class="merchant-unit"> 笔</text></view><view class="muted">今日预约</view></view>
        <view class="grow"><view class="metric">{{daily}}<text class="merchant-unit"> 笔</text></view><view class="muted">今日确认场地收益</view></view>
      </view>
      <view class="panel" id="merchant-schedule">
        <view class="row split"><view class="heading">设备排班</view><view class="muted small">{{orders.length}} 笔记录</view></view>
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="selectDate">
          <view class="field row split touch-control"><text>{{date === today ? '今天 · ' : ''}}{{date}}</text><text class="muted small">切换日期 ›</text></view>
        </picker>
        <view class="muted small">开放 {{windowLabel}}</view>
        <block wx:if="{{track}}">
          <view class="schedule-track action">
            <view wx:for="{{track.segments}}" wx:key="id" class="schedule-segment schedule-{{item.tone}}" style="flex-grow: {{item.minutes}}"/>
          </view>
          <view class="row split muted small"><text>{{track.start}}</text><text>{{track.end}}</text></view>
          <view class="row wrap schedule-legend">
            <view class="row"><view class="schedule-key schedule-open"/>开放</view>
            <view class="row"><view class="schedule-key schedule-booked"/>已预约</view>
            <view class="row"><view class="schedule-key schedule-buffer"/>缓冲</view>
            <view class="row"><view class="schedule-key schedule-closed"/>未开放</view>
            <view class="row"><view class="schedule-key schedule-affected"/>受影响</view>
          </view>
          <view class="muted small action">相邻预约间隔 {{deviceBuffer}} 分钟，闭店前预留 {{closingBuffer}} 分钟。</view>
        </block>
        <view class="divider merchant-order" wx:for="{{orders}}" wx:key="id">
          <view class="row split"><text class="merchant-order-time">{{item.startTime}}–{{item.endTime}}</text><text class="status-pill status-{{item.stateTone}}">{{item.stateLabel}}</text></view>
          <view class="muted small">{{item.taskName}} · {{item.id}}</view>
        </view>
        <view wx:if="{{!orders.length}}" class="divider muted">{{track ? '当天还没有预约。' : '当天未设置开放时段。'}}</view>
        <view class="divider muted small">{{station.device.id}} · 归还由凌矩核验</view>
      </view>
    </block>
    <block wx:if="{{section === 'schedule'}}">
      <view class="panel">
        <view class="heading">每周开放计划</view>
        <view class="muted">每天最多四段。移除全部时段后，该星期几暂停。</view>
        <picker range="{{days}}" value="{{weekday}}" bindchange="weekday"><view class="field">{{days[weekday]}} ›</view></picker>
        <template is="range-editor" data="{{ranges: weekRanges, field: 'weekRanges'}}"/>
        <button class="primary action" bindtap="saveWeek">预览周计划变更</button>
      </view>
      <view class="panel">
        <view class="heading">指定日期调整</view>
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="selectDate">
          <view class="field">{{date}}　{{windowLabel}} ›</view>
        </picker>
        <template is="range-editor" data="{{ranges: dayRanges, field: 'dayRanges'}}"/>
        <button class="primary action" bindtap="saveDate">预览单日变更</button>
        <view class="row action">
          <button class="grow danger" bindtap="pauseDate">暂停当日</button>
          <button class="grow ghost" bindtap="restoreDate">恢复周计划</button>
        </view>
      </view>
      <view wx:if="{{scheduleReview}}" class="panel" id="schedule-review">
        <view class="heading">{{scheduleReview.title}}</view>
        <view class="muted">{{scheduleReview.site}} · {{scheduleReview.hours}}</view>
        <view class="notice">将新增影响 {{scheduleReview.orders.length}} 笔预约</view>
        <view class="divider" wx:for="{{scheduleReview.orders}}" wx:key="id">
          <view class="row split"><text>{{item.id}} · {{item.interval}}</text><text class="badge">{{item.stateLabel}}</text></view>
          <view class="muted">{{item.impactText}}</view>
        </view>
        <view class="row action">
          <button class="grow ghost" bindtap="cancelSchedule">返回编辑</button>
          <button class="grow primary" bindtap="confirmSchedule">确认变更</button>
        </view>
      </view>
    </block>
    <view class="panel" wx:if="{{section === 'income'}}">
      <view class="heading">自然月场地账目</view>
      <picker mode="date" fields="month" value="{{period}}" bindchange="selectPeriod"><view class="field">{{period}} ›</view></picker>
      <view class="muted">模拟实际采集且核验归还后计入待结算。金额及结算日待协议确认。</view>
      <view class="divider" wx:for="{{currentEarnings}}" wx:key="id">
        <view class="row split"><text>{{item.orderId}} · {{item.kindLabel}}</text><text class="badge">{{item.state}}</text></view>
        <view class="muted">{{item.amount}}</view>
      </view>
      <view wx:if="{{!currentEarnings.length}}" class="divider muted">本月暂无确认账目。</view>
    </view>
  </block>
    <view class="dock dock-nav" wx:if="{{deployed}}">
      <button wx:for="{{navItems}}" wx:key="section" class="dock-item {{section === item.section ? 'is-active' : ''}}" data-section="{{item.section}}" bindtap="section">
        <view class="dock-mark"><image class="icon" src="{{item.icon}}" mode="aspectFit"/></view>
        <text>{{item.label}}</text>
      </button>
    </view>
  <view class="tagline">演示数据 · 仅保存在当前设备</view>
</view>
