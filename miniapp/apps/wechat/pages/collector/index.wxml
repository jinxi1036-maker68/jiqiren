<view class="screen with-dock collector-d1">
  <view class="list-masthead" wx:if="{{section !== 'credit'}}">
    <view class="row split">
      <view class="row city-mark"><image class="icon icon-small" src="/assets/icons/pin.svg" mode="aspectFit"/><text>平顶山 · {{region ? regions[region] : '全城'}}</text></view>
      <button class="d1-link" hover-class="d1-pressed" bindtap="switchRole">切换身份</button>
    </view>
    <view class="row split">
      <view class="grow">
        <view class="title">{{section === 'tasks' ? '今天去哪采集' : section === 'orders' ? '我的订单' : section === 'income' ? '我的收益' : '消息'}}</view>
        <view class="muted">{{section === 'tasks' ? availableCount + ' 个站点有可约时段' : '模拟北京时间 ' + clock}}</view>
      </view>
      <text class="muted small">{{personas[persona]}}</text>
    </view>
  </view>
  <block wx:if="{{section === 'tasks'}}">
    <button wx:if="{{nextOrder && !replaceId}}" class="panel d1-next" hover-class="d1-pressed" data-id="{{nextOrder.id}}" bindtap="order">
      <view class="d1-next-icon"><image class="icon icon-small" src="/assets/icons/calendar.svg" mode="aspectFit"/></view>
      <view class="grow">
        <view class="d1-next-title">{{nextOrder.submitted ? '最近进度' : '下一单'}} · {{nextOrder.stationName}}</view>
        <view class="muted small d1-numeric">{{nextOrder.date === today ? nextOrder.time : nextOrder.interval}}</view>
      </view>
      <view class="d1-next-end"><text class="status-pill status-{{nextOrder.stateTone}}">{{nextOrder.stateLabel}}</text><text class="d1-next-link">{{nextOrder.link}} ›</text></view>
    </button>
    <block wx:if="{{!replaceId && stories.length}}">
      <view class="row split d1-block-head"><view class="heading">站内动态</view><text class="muted small">横滑看更多</text></view>
      <swiper class="d1-stories" current="{{storyIndex}}" bindchange="changeStory">
        <swiper-item wx:for="{{stories}}" wx:key="id">
          <view class="d1-story d1-story-{{item.id}}">
            <image class="d1-story-art" src="{{item.art}}" mode="aspectFit"/>
            <view class="d1-story-copy">
              <text class="d1-story-label">{{item.label}}</text>
              <view class="d1-story-title">{{item.title}}</view>
              <view wx:if="{{item.amount}}" class="d1-story-amount">{{item.amount}}</view>
              <view class="d1-story-detail">{{item.detail}}</view>
              <button class="d1-story-link" hover-class="d1-story-pressed" data-id="{{item.id}}" data-view="{{item.id}}" bindtap="openStory">{{item.action}} ›</button>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="d1-story-tabs">
        <button wx:for="{{stories}}" wx:key="id" class="{{storyIndex === index ? 'd1-selected' : ''}}" data-index="{{index}}" hover-class="d1-pressed" bindtap="selectStory">{{item.tab}}</button>
      </view>
    </block>
    <view wx:if="{{replaceId}}" class="notice row split"><view class="grow">正在为 {{replaceId}} 改约。原订单保留至新时段确认。</view><button class="ghost subtle-button" bindtap="exitReschedule">退出改约</button></view>
    <view wx:if="{{!profile.allowed}}" class="notice">新预约受限，已有预约可按原安排履行。</view>
    <view class="d1-filter">
      <view class="field row filter-search">
        <image class="icon icon-small" src="/assets/icons/search.svg" mode="aspectFit"/>
        <input class="grow" placeholder="搜站点、地址或任务" value="{{search}}" bindinput="search"/>
      </view>
      <view class="row filter-row">
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="date"><view class="filter-chip">{{dateLabel}} ▾</view></picker>
        <picker range="{{regions}}" value="{{region}}" bindchange="region"><view class="filter-chip">{{regions[region]}} ▾</view></picker>
        <picker range="{{sorts}}" value="{{sort}}" bindchange="sort"><view class="filter-chip">{{sorts[sort]}} ▾</view></picker>
      </view>
    </view>
    <view class="row split d1-block-head">
      <view class="heading">采集站点</view>
      <button class="d1-link" data-view="guide" bindtap="openAccount">服务指南 ›</button>
    </view>
    <button class="panel d1-station" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" hover-class="d1-pressed" bindtap="task">
      <image class="site-thumb" src="{{item.art}}" mode="aspectFill"/>
      <view class="grow">
        <view class="subheading">{{item.title}}</view>
        <view class="muted small">{{item.name}} · {{item.district}} · {{item.address}}</view>
        <view class="row split d1-station-rate">
          <view class="price">¥{{item.rate}}<text class="price-unit">/ 有效小时</text></view>
          <text wx:if="{{item.openCount}}" class="muted small d1-numeric">{{item.earliest}} 可约</text>
        </view>
        <view class="muted small">{{item.openCount ? item.min + '–' + item.max + ' 分钟 · 开放 ' + item.opening : item.availabilityReason}}</view>
      </view>
      <text class="d1-arrow">›</text>
    </button>
    <view class="account-paper account-empty" wx:if="{{!cards.length}}">
      <view class="account-heading">当前条件下没有任务</view>
      <view class="account-copy">可以换个区域、日期或关键词继续找。</view>
      <button class="ghost account-button" wx:if="{{search || region || date !== today || sort}}" bindtap="clearFilters">清除筛选</button>
    </view>
  </block>
  <block wx:if="{{section === 'orders'}}">
    <view wx:if="{{orderFilter}}" class="row split d1-block-head">
      <view class="heading">{{orderFilterLabel}} · {{shownOrders.length}} 笔</view>
      <button class="d1-link" data-section="orders" bindtap="section">全部订单 ›</button>
    </view>
    <button class="panel discovery-card d1-order-card" wx:for="{{shownOrders}}" wx:key="id" data-id="{{item.id}}" hover-class="d1-pressed" bindtap="order">
      <view class="row split"><view class="subheading grow">{{item.taskName}}</view><view class="status-pill status-{{item.stateTone}}">{{item.stateLabel}}</view></view>
      <view class="muted action">{{item.stationName}} · {{item.interval}}</view>
      <view class="row split divider"><text class="muted small">订单 {{item.id}}</text><text class="discovery-action">查看订单 ›</text></view>
    </button>
    <view class="account-paper account-empty" wx:if="{{!shownOrders.length}}">
      <view class="account-heading">{{orderFilter ? '暂无' + orderFilterLabel + '的订单' : '还没有预约'}}</view>
      <view class="account-copy">{{orderFilter ? '可切回全部订单查看其他进度。' : '选好站点和时段后，订单会出现在这里。'}}</view>
      <button wx:if="{{!orderFilter}}" class="ghost account-button" data-section="tasks" bindtap="section">去找采集任务</button>
    </view>
  </block>
  <block wx:if="{{section === 'income'}}">
    <view class="panel">
      <view class="heading">采集员月度收益</view>
      <picker mode="date" fields="month" value="{{period}}" bindchange="period"><view class="field">{{period}} ›</view></picker>
      <view class="row wrap">
        <view class="grow tile"><view class="muted">预计</view><view class="subheading">¥{{income.estimated}}</view></view>
        <view class="grow tile"><view class="muted">待审核</view><view class="subheading">¥{{income.pending}}</view></view>
        <view class="grow tile"><view class="muted">已确认</view><view class="subheading">¥{{income.confirmed}}</view></view>
      </view>
      <view class="notice">以上为虚构金额。{{income.pendingCount}} 笔待审可跨期，审核确认后才进入月度账目。</view>
    </view>
    <view class="panel" wx:for="{{income.entries}}" wx:key="id">
      <view class="row split"><view class="subheading">{{item.kindLabel}}</view><view class="badge">{{item.state}}</view></view>
      <view class="row split"><view class="muted">{{item.orderId}} · {{item.period}}</view><view>{{item.amount}}</view></view>
    </view>
    <view class="panel muted" wx:if="{{!income.entries.length}}">该月暂无确认账目或待发放补贴。</view>
  </block>
  <block wx:if="{{section === 'messages'}}">
    <view class="panel">
      <view class="row split"><view class="heading">站内消息</view><view class="badge">{{unread}} 条未读</view></view>
      <view class="row action">
        <button class="grow" bindtap="readAll">全部已读</button>
        <button class="grow ghost" bindtap="messageSettings">消息设置</button>
      </view>
      <button class="ghost action" bindtap="toggleDemo">{{showDemo ? '收起演示控制' : '展开演示控制'}}</button>
      <block wx:if="{{showDemo}}">
        <view class="muted divider">推进模拟时钟后生成到期提醒。</view>
        <view class="row action">
          <button class="grow" data-delta="30" bindtap="jump">＋30 分钟</button>
          <button class="grow" data-delta="1440" bindtap="jump">＋1 天</button>
        </view>
      </block>
    </view>
    <view wx:for="{{messages}}" wx:key="key" class="panel" data-key="{{item.key}}" data-id="{{item.orderId}}" bindtap="openMessage">
      <view class="row split"><view class="subheading">{{item.title}}</view><view class="badge" wx:if="{{!item.read}}">未读</view></view>
      <view>{{item.text}}</view><view class="muted">{{item.time}} {{item.orderId}}</view>
    </view>
    <view class="panel muted" wx:if="{{!messages.length}}">暂无站内消息。</view>
  </block>
  <block wx:if="{{section === 'credit'}}">
    <view class="d1-profile-head">
      <view class="row split"><view class="title">我的</view><button class="d1-link" hover-class="d1-pressed" bindtap="switchRole">切换身份 ›</button></view>
      <view class="row d1-profile-id">
        <view class="d1-avatar">采</view>
        <view class="grow"><view class="subheading">{{account.name}}</view><view class="muted small">个人采集员 · {{account.loggedIn ? '演示账号' : '未登录'}}</view></view>
        <button wx:if="{{!account.loggedIn}}" class="d1-link" data-view="login" bindtap="openAccount">点击登录 ›</button>
      </view>
    </view>
    <view class="panel d1-profile-orders">
      <view class="row split"><view class="heading">我的订单</view><button class="d1-link" data-section="orders" bindtap="section">全部订单 ›</button></view>
      <view class="d1-order-tabs">
        <button wx:for="{{orderTabs}}" wx:key="id" data-section="orders" data-filter="{{item.id}}" hover-class="d1-pressed" bindtap="section">
          <view class="d1-order-icon"><image class="icon" src="{{item.icon}}" mode="aspectFit"/><text wx:if="{{item.count}}" class="d1-count">{{item.count > 99 ? '99+' : item.count}}</text></view>
          <text>{{item.label}}</text>
        </button>
      </view>
    </view>
    <view class="panel d1-profile-group" wx:for="{{profileGroups}}" wx:key="id" wx:for-item="group">
      <button class="d1-cell" wx:for="{{group.items}}" wx:key="label" data-view="{{item.view}}" data-section="{{item.section}}" hover-class="d1-pressed" bindtap="profileEntry">
        <text class="grow">{{item.label}}</text>
        <text wx:if="{{item.view === 'coupons' && account.coupons.length}}" class="muted">{{account.coupons.length}}</text>
        <text class="d1-arrow">›</text>
      </button>
    </view>
    <view class="panel d1-profile-group">
      <button class="d1-cell" data-view="credit" hover-class="d1-pressed" bindtap="openAccount"><text class="grow">信誉记录</text><text class="d1-arrow">›</text></button>
    </view>
    <view class="account-paper">
      <view class="row split"><view class="subheading">演示设置</view><button class="account-link touch-control" bindtap="toggleDemo">{{showDemo ? '收起' : '展开 ›'}}</button></view>
      <picker wx:if="{{showDemo}}" range="{{personas}}" value="{{persona}}" bindchange="persona">
        <view class="field">切换演示采集员　{{personas[persona]}} ›</view>
      </picker>
    </view>
  </block>
  <view class="tagline">演示数据 · 站内消息 · 虚构金额</view>
  <view class="dock dock-nav">
    <button wx:for="{{navItems}}" wx:key="section" class="dock-item {{section === item.section ? 'is-active' : ''}}" data-section="{{item.section}}" hover-class="d1-pressed" bindtap="section">
      <view class="dock-mark">
        <image class="icon" src="{{item.icon}}" mode="aspectFit"/>
        <view wx:if="{{item.section === 'messages' && unread}}" class="unread-dot">{{unread > 99 ? '99+' : unread}}</view>
      </view>
      <text>{{item.label}}</text>
    </button>
  </view>
</view>
