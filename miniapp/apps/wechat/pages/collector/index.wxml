<import src="../../templates/account-hub.wxml"/>
<view class="screen with-dock">
  <view class="list-masthead" wx:if="{{section !== 'credit'}}">
    <view class="row split">
      <view class="row city-mark"><image class="icon icon-small" src="/assets/icons/pin.svg" mode="aspectFit"/><text>平顶山</text><text class="badge">模拟体验</text></view>
      <button class="ghost subtle-button" hover-class="control-pressed" bindtap="switchRole">切换身份</button>
    </view>
    <view class="row split action">
      <view class="grow">
        <view class="title">{{section === 'tasks' ? (nextOrder && !replaceId ? '我的采集' : '找采集任务') : section === 'orders' ? '预约' : section === 'income' ? '收益' : section === 'messages' ? '消息' : '我的'}}</view>
        <view class="muted">{{section === 'tasks' ? (nextOrder && !replaceId ? '预约进度和站点任务' : availableCount + ' 个站点有可约时段') : '模拟北京时间 ' + clock}}</view>
      </view>
      <text class="muted small">{{personas[persona]}}</text>
    </view>
  </view>
  <block wx:if="{{section === 'tasks'}}">
    <view class="panel next-order collector-next" wx:if="{{nextOrder && !replaceId}}">
      <view class="row split"><view class="kicker">{{nextOrder.submitted ? '最近进度' : '下一单'}}</view><view class="status-pill status-{{nextOrder.stateTone}}">{{nextOrder.stateLabel}}</view></view>
      <view class="subheading action">{{nextOrder.taskName}}</view>
      <view class="muted">{{nextOrder.stationName}} · {{nextOrder.interval}}</view>
      <view class="row split divider">
        <view class="grow">{{nextOrder.hint}}</view>
        <button class="primary order-link" hover-class="control-pressed" data-id="{{nextOrder.id}}" bindtap="order">{{nextOrder.submitted ? '查看结果' : '打开订单'}}</button>
      </view>
    </view>
    <button wx:if="{{account.showCampaign && !replaceId}}" class="campaign-banner campaign-entry" hover-class="control-pressed" data-view="benefits" bindtap="openAccount">
      <view class="grow"><view class="campaign-label">新手采集计划 · 演示</view><view class="campaign-title">领取体验券，完成首单</view></view>
      <view class="campaign-arrow">›</view>
    </button>
    <view wx:if="{{replaceId}}" class="notice row split"><view class="grow">正在为 {{replaceId}} 改约。原订单保留至新时段确认。</view><button class="ghost subtle-button" bindtap="exitReschedule">退出改约</button></view>
    <view wx:if="{{!profile.allowed}}" class="notice">新预约受限，已有预约可按原安排履行。</view>
    <view class="row split discovery-heading">
      <view class="account-heading">采集站点</view>
      <button class="account-link" data-view="guide" bindtap="openAccount">采集怎么做 ›</button>
    </view>
    <view class="panel filter-panel">
      <view class="field row filter-search">
        <image class="icon icon-small" src="/assets/icons/search.svg" mode="aspectFit"/>
        <input class="grow" placeholder="搜站点、地址或任务" value="{{search}}" bindinput="search"/>
      </view>
      <view class="row filter-row">
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="date"><view class="filter-chip">{{dateLabel}} ▾</view></picker>
        <picker range="{{regions}}" value="{{region}}" bindchange="region"><view class="filter-chip">{{regions[region]}} ▾</view></picker>
        <picker range="{{sorts}}" value="{{sort}}" bindchange="sort"><view class="filter-chip">{{sorts[sort]}} ▾</view></picker>
      </view>
    </view>
    <button class="panel site-card discovery-card" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" hover-class="control-pressed" bindtap="task">
      <view class="row">
        <image class="site-thumb" src="{{item.art}}" mode="aspectFill"/>
        <view class="grow">
          <view class="row split"><text class="status-pill status-quiet">{{item.category}}</text><text class="muted small">{{item.district}}</text></view>
          <view class="site-name">{{item.title}}</view>
          <view class="muted">{{item.name}} · {{item.address}}</view>
        </view>
      </view>
      <view class="row split divider">
        <view class="grow">
          <view class="price">¥{{item.rate}}<text class="price-unit">/ 有效小时 · 示例</text></view>
          <view class="availability {{item.openCount ? '' : 'availability-closed'}}">
            <view class="availability-dot"/>{{item.openCount ? '最早 ' + item.earliest + ' 可约' : item.availabilityReason}}
          </view>
          <view class="muted small">{{item.min}}–{{item.max}} 分钟 · 开放 {{item.opening}}</view>
        </view>
        <view class="discovery-action">{{item.openCount ? '查看时段' : '查看详情'}} <text>›</text></view>
      </view>
    </button>
    <view class="account-paper account-empty" wx:if="{{!cards.length}}">
      <view class="account-heading">当前条件下没有任务</view>
      <view class="account-copy">可以换个区域、日期或关键词继续找。</view>
      <button class="ghost account-button" wx:if="{{search || region || date !== today || sort}}" bindtap="clearFilters">清除筛选</button>
    </view>
  </block>
  <block wx:if="{{section === 'orders'}}">
    <view class="section heading">我的预约</view>
    <button class="panel discovery-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" hover-class="control-pressed" bindtap="order">
      <view class="row split"><view class="subheading grow">{{item.taskName}}</view><view class="status-pill status-{{item.stateTone}}">{{item.stateLabel}}</view></view>
      <view class="muted action">{{item.stationName}} · {{item.interval}}</view>
      <view class="row split divider"><text class="muted small">订单 {{item.id}}</text><text class="discovery-action">查看订单 ›</text></view>
    </button>
    <view class="account-paper account-empty" wx:if="{{!orders.length}}">
      <view class="account-heading">还没有预约</view><view class="account-copy">选好站点和时段后，订单会出现在这里。</view>
      <button class="ghost account-button" data-section="tasks" bindtap="section">去找采集任务</button>
    </view>
  </block>
  <block wx:if="{{section === 'income'}}">
    <view class="panel">
      <view class="heading">采集员月度收益</view>
      <picker mode="date" fields="month" value="{{period}}" bindchange="period"><view class="field">{{period}} ›</view></picker>
      <view class="row wrap">
        <view class="grow tile"><view class="muted">预计</view><view class="subheading">¥{{income.estimated}}</view></view>
        <view class="grow tile"><view class="muted">待审核</view><view class="subheading">¥{{income.pending}}</view></view>
        <view class="grow tile"><view class="muted">已确认</view><view class="subheading">¥{{income.confirmed}}</view></view>
      </view>
      <view class="notice">以上为虚构金额。{{income.pendingCount}} 笔待审可跨期，审核确认后才进入月度账目。</view>
    </view>
    <view class="panel" wx:for="{{income.entries}}" wx:key="id">
      <view class="row split"><view class="subheading">{{item.kindLabel}}</view><view class="badge">{{item.state}}</view></view>
      <view class="row split"><view class="muted">{{item.orderId}} · {{item.period}}</view><view>{{item.amount}}</view></view>
    </view>
    <view class="panel muted" wx:if="{{!income.entries.length}}">该月暂无确认账目或待发放补贴。</view>
  </block>
  <block wx:if="{{section === 'messages'}}">
    <view class="panel">
      <view class="row split"><view class="heading">站内消息</view><view class="badge">{{unread}} 条未读</view></view>
      <view class="row action">
        <button class="grow" bindtap="readAll">全部已读</button>
        <button class="grow ghost" bindtap="messageSettings">消息设置</button>
      </view>
      <button class="ghost action" bindtap="toggleDemo">{{showDemo ? '收起演示控制' : '展开演示控制'}}</button>
      <block wx:if="{{showDemo}}">
        <view class="muted divider">推进模拟时钟后生成到期提醒。</view>
        <view class="row action">
          <button class="grow" data-delta="30" bindtap="jump">＋30 分钟</button>
          <button class="grow" data-delta="1440" bindtap="jump">＋1 天</button>
        </view>
      </block>
    </view>
    <view wx:for="{{messages}}" wx:key="key" class="panel" data-key="{{item.key}}" data-id="{{item.orderId}}" bindtap="openMessage">
      <view class="row split"><view class="subheading">{{item.title}}</view><view class="badge" wx:if="{{!item.read}}">未读</view></view>
      <view>{{item.text}}</view><view class="muted">{{item.time}} {{item.orderId}}</view>
    </view>
    <view class="panel muted" wx:if="{{!messages.length}}">暂无站内消息。</view>
  </block>
  <block wx:if="{{section === 'credit'}}">
    <template is="account-hub" data="{{account: account}}"/>
    <view class="account-paper">
      <view class="row split"><view class="subheading">演示设置</view><button class="account-link touch-control" bindtap="toggleDemo">{{showDemo ? '收起' : '展开 ›'}}</button></view>
      <picker wx:if="{{showDemo}}" range="{{personas}}" value="{{persona}}" bindchange="persona">
        <view class="field">切换演示采集员　{{personas[persona]}} ›</view>
      </picker>
    </view>
  </block>
  <view class="tagline">演示数据 · 站内消息 · 虚构金额</view>
  <view class="dock dock-nav">
    <button wx:for="{{navItems}}" wx:key="section" class="dock-item {{section === item.section ? 'is-active' : ''}}" data-section="{{item.section}}" bindtap="section">
      <view class="dock-mark">
        <image class="icon" src="{{item.icon}}" mode="aspectFit"/>
        <view wx:if="{{item.section === 'messages' && unread}}" class="unread-dot">{{unread > 99 ? '99+' : unread}}</view>
      </view>
      <text>{{item.label}}</text>
    </button>
  </view>
</view>
