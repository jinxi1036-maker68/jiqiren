<import src="../../templates/site-guide.wxml"/>
<view class="screen with-dock collector-d1 collector-ink">
  <view class="row ink-brand">
    <view class="ink-mark" aria-hidden="true"></view>
    <text class="ink-wordmark">凌矩</text><text class="muted small grow">共享采集站</text>
    <button class="d1-link" hover-class="d1-pressed" bindtap="switchRole">切换身份</button>
  </view>
  <view class="list-masthead" wx:if="{{section !== 'credit'}}">
    <view class="row split">
      <view class="title grow">{{section === 'tasks' ? '找采集任务' : section === 'stores' ? '合作门店' : section === 'scan' ? '扫一扫' : '消息'}}</view>
      <view wx:if="{{section === 'tasks' || section === 'stores'}}" class="row city-mark"><image class="icon icon-small" src="/assets/icons/pin.svg" mode="aspectFit"/><text>平顶山</text></view>
      <text wx:elif="{{section === 'scan'}}" class="muted small">设备操作 · 模拟</text>
    </view>
  </view>
  <block wx:if="{{section === 'tasks'}}">
    <view class="d1-filter">
      <view class="field row filter-search">
        <image class="icon icon-small" src="/assets/icons/search.svg" mode="aspectFit"/>
        <input class="grow" placeholder="搜门店、地址或任务" value="{{search}}" bindinput="search"/>
      </view>
      <view class="row wrap filter-row ink-filters">
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="date"><view class="filter-chip">{{dateLabel}} ▾</view></picker>
        <picker range="{{regions}}" value="{{region}}" bindchange="region"><view class="filter-chip">{{regions[region]}} ▾</view></picker>
        <picker range="{{sorts}}" value="{{sort}}" bindchange="sort"><view class="filter-chip">{{sorts[sort]}} ▾</view></picker>
        <button class="filter-chip {{onlyAvailable ? 'ink-filter-active' : ''}}" hover-class="d1-pressed" bindtap="toggleAvailable" aria-pressed="{{onlyAvailable}}">仅看可约</button>
      </view>
    </view>
    <button wx:if="{{nextOrder && !replaceId}}" class="panel d1-next" hover-class="d1-pressed" data-id="{{nextOrder.id}}" bindtap="order">
      <view class="d1-next-icon"><image class="icon icon-small" src="/assets/icons/calendar.svg" mode="aspectFit"/></view>
      <view class="grow">
        <view class="d1-next-title">{{nextOrder.submitted ? '最近进度' : '下一单'}} · {{nextOrder.stationName}}</view>
        <view class="muted d1-numeric">{{nextOrder.date === today ? nextOrder.time : nextOrder.interval}}</view>
      </view>
      <view class="d1-next-end"><text class="status-pill status-{{nextOrder.stateTone}}">{{nextOrder.stateLabel}}</text><text class="d1-next-link">{{nextOrder.link}} ›</text></view>
    </button>
    <view wx:if="{{replaceId}}" class="notice row split"><view class="grow">正在为 {{replaceId}} 改约。原订单保留至新时段确认。</view><button class="ghost subtle-button" bindtap="exitReschedule">退出改约</button></view>
    <view wx:if="{{!profile.allowed}}" class="notice">新预约受限，已有预约可按原安排履行。</view>
    <view class="row split d1-block-head"><view class="heading">采集站点</view><text class="muted small">{{clockLabel}} · {{availableCount}} 个可约</text></view>
    <view class="panel ink-stations" wx:if="{{cards.length}}">
      <button class="d1-station" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" hover-class="d1-pressed" bindtap="task">
        <view class="row split ink-station-title">
          <view class="subheading grow">{{item.title}}</view>
          <text class="muted">{{item.min / 60}} 小时{{item.min < item.max ? '起' : ''}}</text>
        </view>
        <view class="muted ink-station-address">{{item.name}} · {{item.district}} {{item.address}}</view>
        <view class="row split d1-station-rate">
          <view class="grow">
            <text wx:if="{{item.openCount}}" class="ink-available d1-numeric">最早 {{item.earliest}}</text>
            <text wx:else class="muted">{{item.availabilityReason}}</text>
            <view class="price">¥{{item.rate}}<text class="price-unit"> / 有效小时 · 示例</text></view>
          </view>
          <view class="ink-task-action {{item.openCount ? '' : 'ink-task-secondary'}}">{{item.openCount ? '选时段' : '看其他日期'}} ›</view>
        </view>
      </button>
    </view>
    <view class="account-paper account-empty" wx:if="{{!cards.length}}">
      <view class="account-heading">{{onlyAvailable ? '这天暂无可约任务' : '当前条件下没有任务'}}</view>
      <view class="account-copy">换个日期、区域或关键词继续找。</view>
      <button class="primary account-button" wx:if="{{date === today}}" data-date="{{tomorrow}}" bindtap="date">看看明天</button>
      <button class="ghost account-button" wx:if="{{search || region || date !== today || sort || onlyAvailable}}" bindtap="clearFilters">清除筛选</button>
    </view>
    <block wx:if="{{!replaceId && stories.length}}">
      <view class="row split d1-block-head"><view class="heading">站内动态</view></view>
      <swiper class="d1-stories" current="{{storyIndex}}" autoplay="{{stories.length > 1}}" circular="{{stories.length > 1}}"
        interval="{{5000}}" duration="{{350}}" bindanimationfinish="finishStory">
        <swiper-item wx:for="{{stories}}" wx:key="id">
          <view class="d1-story d1-story-{{item.id}}">
            <image class="d1-story-art" src="{{item.art}}" mode="aspectFit"/>
            <view class="d1-story-copy">
              <text class="d1-story-label">{{item.label}}</text>
              <view class="d1-story-title">{{item.title}}</view>
              <view wx:if="{{item.amount}}" class="d1-story-amount">{{item.amount}}</view>
              <view class="d1-story-detail">{{item.detail}}</view>
              <button class="d1-story-link" hover-class="d1-story-pressed" data-id="{{item.id}}" data-view="{{item.id}}" bindtap="openStory">{{item.action}} ›</button>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="d1-story-tabs">
        <button wx:for="{{stories}}" wx:key="id" class="{{storyIndex === index ? 'd1-selected' : ''}}" data-index="{{index}}" hover-class="d1-pressed" bindtap="selectStory">{{item.tab}}</button>
      </view>
    </block>
  </block>
  <block wx:if="{{section === 'stores'}}">
    <view class="panel ink-stations" wx:if="{{stores.length}}">
      <view class="ink-store-item" wx:for="{{stores}}" wx:key="id">
        <button class="d1-station" data-id="{{item.id}}" hover-class="d1-pressed" bindtap="showStore" aria-expanded="{{storeId === item.id}}">
          <view class="row split"><view class="subheading grow">{{item.name}}</view><text class="muted small">{{storeId === item.id ? '收起' : '到店指引 ›'}}</text></view>
          <view class="muted small">{{item.address}}</view>
          <view class="muted small">今日 {{item.opening}}</view>
        </button>
        <template wx:if="{{storeId === item.id}}" is="site-guide" data="{{guide: guide}}"/>
      </view>
    </view>
    <view class="panel muted" wx:else>暂时没有已开放的合作门店。</view>
    <view class="ink-promotion"><view class="muted small">门店福利 · 示意</view><view class="subheading">到店积分</view><view class="muted small">合作门店的活动和使用条件将在这里展示。</view></view>
  </block>
  <block wx:if="{{section === 'scan'}}">
    <view class="panel ink-scan">
      <view class="ink-scan-mark"><image src="/assets/icons/scan.svg" mode="aspectFit"/></view>
      <view class="heading">选择模拟设备</view>
      <view class="muted small">匹配本人预约后，回到本单取机或归还。</view>
      <picker wx:if="{{scanDevices.length}}" range="{{scanDevices}}" range-key="label" value="{{scanDeviceIndex}}" bindchange="scanDevice">
        <view class="field">{{scanDevices[scanDeviceIndex].label}} ▾</view>
      </picker>
      <button class="primary" disabled="{{!scanDevices.length}}" hover-class="d1-primary-pressed" bindtap="simulateScan">模拟扫设备码</button>
    </view>
  </block>
  <block wx:if="{{section === 'messages'}}">
    <view class="panel">
      <view class="row split"><view class="heading">站内消息</view><view class="badge">{{unread}} 条未读</view></view>
      <view class="row action">
        <button class="grow" bindtap="readAll">全部已读</button>
        <button class="grow ghost" bindtap="messageSettings">消息设置</button>
      </view>
      <button class="ghost action" bindtap="toggleDemo">{{showDemo ? '收起演示控制' : '展开演示控制'}}</button>
      <block wx:if="{{showDemo}}">
        <view class="muted divider">推进模拟时钟后生成到期提醒。</view>
        <view class="row action">
          <button class="grow" data-delta="30" bindtap="jump">＋30 分钟</button>
          <button class="grow" data-delta="1440" bindtap="jump">＋1 天</button>
        </view>
      </block>
    </view>
    <view wx:for="{{messages}}" wx:key="key" class="panel" data-key="{{item.key}}" data-id="{{item.orderId}}" bindtap="openMessage">
      <view class="row split"><view class="subheading">{{item.title}}</view><view class="badge" wx:if="{{!item.read}}">未读</view></view>
      <view>{{item.text}}</view><view class="muted">{{item.time}} {{item.orderId}}</view>
    </view>
    <view class="panel muted" wx:if="{{!messages.length}}">暂无站内消息。</view>
  </block>
  <block wx:if="{{section === 'credit'}}">
    <view class="row d1-profile-id">
      <view class="d1-avatar">采</view>
      <view class="grow"><view class="subheading">{{account.name}}</view><view class="muted small">个人采集员</view></view>
      <button wx:if="{{!account.loggedIn}}" class="d1-link" data-view="login" bindtap="openAccount">点击登录 ›</button>
      <text wx:else class="ink-account-state">● 体验账号</text>
    </view>
    <view class="ink-wallet">
      <view class="ink-wallet-mark"></view>
      <view class="row split ink-wallet-head"><view class="row"><image class="icon icon-small" src="/assets/icons/wallet.svg" mode="aspectFit"/>我的钱包</view><text>{{period}} · 模拟账目</text></view>
      <view class="ink-assets">
        <button class="{{walletPanel === 'balance' ? 'ink-asset-active' : ''}}" data-panel="balance" aria-expanded="{{walletPanel === 'balance'}}" hover-class="ink-wallet-pressed" bindtap="wallet">
          <text>余额 {{walletPanel === 'balance' ? '⌃' : '⌄'}}</text><view class="d1-numeric"><text>¥</text>{{income.confirmed}}</view>
        </button>
        <button class="{{walletPanel === 'coupons' ? 'ink-asset-active' : ''}}" data-panel="coupons" aria-expanded="{{walletPanel === 'coupons'}}" hover-class="ink-wallet-pressed" bindtap="wallet">
          <text>优惠券 {{walletPanel === 'coupons' ? '⌃' : '⌄'}}</text><view class="d1-numeric">{{account.coupons.length}}</view>
        </button>
        <button class="{{walletPanel === 'points' ? 'ink-asset-active' : ''}}" data-panel="points" aria-expanded="{{walletPanel === 'points'}}" hover-class="ink-wallet-pressed" bindtap="wallet">
          <text>门店积分 {{walletPanel === 'points' ? '⌃' : '⌄'}}</text><view class="d1-numeric">—</view>
        </button>
      </view>
      <view class="ink-wallet-detail" wx:if="{{walletPanel === 'balance'}}">
        <view class="row split ink-wallet-detail-head">
          <text>余额明细</text><picker mode="date" fields="month" value="{{period}}" bindchange="period"><view class="ink-wallet-month">{{period}} ▾</view></picker>
        </view>
        <view class="row split"><text>已确认 · 待结算</text><text class="d1-numeric">¥{{income.confirmed}}</text></view>
        <view class="row split"><text>待审核 · {{income.pendingCount}} 笔</text><text class="d1-numeric">¥{{income.pending}}</text></view>
        <view class="row split"><text>预约预计</text><text class="d1-numeric">¥{{income.estimated}}</text></view>
        <view class="ink-wallet-entry" wx:for="{{income.entries}}" wx:key="id">
          <view class="row split"><text>{{item.kindLabel}} · {{item.orderId}}</text><text class="d1-numeric">{{item.amount}}</text></view>
          <text>{{item.state}}</text>
        </view>
      </view>
      <view class="ink-wallet-detail" wx:elif="{{walletPanel === 'coupons'}}">
        <view class="row split ink-wallet-detail-head"><text>我的优惠券</text><button class="ink-wallet-link" data-view="benefits" bindtap="openAccount">去领券 ›</button></view>
        <view wx:for="{{account.coupons}}" wx:key="id" class="ink-wallet-entry"><view>{{item.title}}</view><text>领取时间 {{item.time}}</text></view>
        <view wx:if="{{!account.coupons.length}}">还没有领取优惠券。</view>
      </view>
      <view class="ink-wallet-detail" wx:elif="{{walletPanel === 'points'}}">
        <view class="ink-wallet-detail-head">门店积分 · 示意</view>
        <view>合作门店发放的积分将在这里按店展示。</view>
      </view>
    </view>
    <view class="panel d1-profile-orders">
      <view class="row split ink-orders-head"><view class="heading">我的订单</view><button class="d1-link" data-filter="all" aria-expanded="{{orderFilter === 'all'}}" bindtap="ordersPanel">全部订单 ›</button></view>
      <view class="d1-order-tabs">
        <button wx:for="{{orderTabs}}" wx:key="id" data-filter="{{item.id}}" class="{{orderFilter === item.id ? 'ink-order-active' : ''}}" aria-expanded="{{orderFilter === item.id}}" hover-class="d1-pressed" bindtap="ordersPanel">
          <view class="d1-order-icon"><image class="icon" src="{{item.icon}}" mode="aspectFit"/><text wx:if="{{item.count}}" class="d1-count">{{item.count > 99 ? '99+' : item.count}}</text></view>
          <text>{{item.label}}</text>
        </button>
      </view>
      <button wx:if="{{attentionCount}}" class="d1-link ink-attention" data-filter="attention" aria-expanded="{{orderFilter === 'attention'}}" bindtap="ordersPanel">待处理 · {{attentionCount}} 笔 ›</button>
      <view class="ink-order-list" wx:if="{{orderFilter}}">
        <view class="muted small">{{orderFilterLabel}} · {{shownOrders.length}} 笔</view>
        <button class="ink-order-row" wx:for="{{shownOrders}}" wx:key="id" data-id="{{item.id}}" hover-class="d1-pressed" bindtap="order">
          <view class="row split"><text class="grow">{{item.stationName}}</text><text class="status-pill status-{{item.stateTone}}">{{item.stateLabel}}</text></view>
          <view class="muted small">{{item.interval}} · {{item.taskName}}</view>
        </button>
        <view wx:if="{{!shownOrders.length}}" class="muted small">这个状态暂无订单。</view>
      </view>
    </view>
    <view class="ink-services">
      <view class="row split"><view class="heading">常用服务</view><button class="d1-link" data-view="credit" bindtap="openAccount">信誉记录 ›</button></view>
      <view class="ink-service-grid">
        <button wx:for="{{profileServices}}" wx:key="label" data-view="{{item.view}}" data-topic="{{item.topic}}" hover-class="d1-pressed" bindtap="openAccount">
          <image class="icon icon-small" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/>{{item.label}}
        </button>
      </view>
    </view>
    <button wx:if="{{account.showCampaign}}" class="ink-promotion" data-view="benefits" hover-class="ink-promo-pressed" bindtap="openAccount">
      <view class="grow"><view class="muted small">合作门店 · 本周</view><view class="subheading">回店有礼</view></view><text class="muted small">推广示意 ›</text>
    </button>
    <view class="ink-demo">
      <button class="d1-link" bindtap="toggleDemo">{{showDemo ? '收起演示设置' : '演示设置 ›'}}</button>
      <picker wx:if="{{showDemo}}" range="{{personas}}" value="{{persona}}" bindchange="persona"><view class="field">切换演示采集员　{{personas[persona]}} ›</view></picker>
    </view>
  </block>
  <view class="dock dock-nav ink-dock" role="tablist" aria-label="采集员导航">
    <button wx:for="{{navItems}}" wx:key="section" class="dock-item {{section === item.section ? 'is-active' : ''}} {{item.section === 'scan' ? 'ink-scan-tab' : ''}}" data-section="{{item.section}}" role="tab" aria-selected="{{section === item.section}}" hover-class="d1-pressed" bindtap="section">
      <view class="dock-mark">
        <image class="icon" src="{{item.icon}}" mode="aspectFit"/>
        <view wx:if="{{item.section === 'messages' && unread}}" class="unread-dot">{{unread > 99 ? '99+' : unread}}</view>
      </view>
      <text>{{item.label}}</text>
    </button>
  </view>
</view>
