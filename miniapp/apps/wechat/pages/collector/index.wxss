@import "../../styles/collector-d1.wxss";

.collector-d1 .list-masthead { margin-bottom: 20rpx; }
.collector-d1 .city-mark { color: #4d5c6d; font-size: 28rpx; font-weight: 400; }
.collector-d1 .d1-next {
  display: flex; width: 100%; min-height: 112rpx; gap: 12rpx; padding: 12rpx 14rpx;
  text-align: left; background: #fff; color: #192636; box-shadow: 0 4rpx 12rpx rgba(25,38,54,.07);
}
.d1-next-icon,.d1-avatar { display: flex; align-items: center; justify-content: center; background: #eaf0f8; color: #1e3d68; flex-shrink: 0; }
.d1-next-icon { width: 58rpx; height: 58rpx; border-radius: 18rpx; }
.d1-next-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; line-height: 40rpx; font-weight: 600; }
.d1-next-end { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; max-width: 40%; }
.d1-next-link { font-size: 24rpx; line-height: 36rpx; color: #1e3d68; white-space: nowrap; }
.d1-block-head { min-height: 60rpx; padding: 0 2rpx; }
.d1-stories { height: 358rpx; margin-top: 4rpx; border-radius: 24rpx; overflow: hidden; }
.d1-story { position: relative; display: flex; align-items: center; height: 100%; box-sizing: border-box; padding: 22rpx 26rpx; }
.d1-story-story { background: linear-gradient(126deg,#19355e,#315785); color: #fff; }
.d1-story-benefits { background: linear-gradient(126deg,#f8e6d5,#f7dcc3); color: #3f2d20; }
.d1-story-promotion { background: linear-gradient(126deg,#eef3f8,#dfe8f2); color: #1e344f; }
.d1-story-copy { z-index: 1; width: calc(100% - 166rpx); }
.d1-story-art { position: absolute; right: 10rpx; top: 50%; width: 226rpx; height: 226rpx; margin-top: -113rpx; pointer-events: none; }
.d1-story-label { display: inline-block; padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 24rpx; line-height: 34rpx; font-weight: 600; background: #dce6f1; }
.d1-story-story .d1-story-label { color: #f0f6fd; background: #29466e; }
.d1-story-benefits .d1-story-label { color: #863d19; background: #f5d3b8; }
.d1-story-title { font-size: 38rpx; line-height: 52rpx; font-weight: 600; margin-top: 6rpx; }
.d1-story-amount { color: #ffe1c7; font-size: 68rpx; line-height: 80rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.d1-story-detail { font-size: 28rpx; line-height: 42rpx; }
.d1-story-story .d1-story-detail { color: #dfecfb; }
.d1-story-benefits .d1-story-detail { color: #6b4934; }
.d1-story-promotion .d1-story-detail { color: #465f7b; }
.collector-d1 .d1-story button.d1-story-link { justify-content: flex-start; min-height: 88rpx; padding: 0; margin: 0; color: inherit; background: transparent; font-size: 28rpx; font-weight: 600; }
.collector-d1 .d1-story button.d1-story-pressed { opacity: .76; }
.d1-story-tabs { display: flex; margin-bottom: 8rpx; }
.collector-d1 .d1-story-tabs button { position: relative; flex: 1; min-height: 88rpx; padding: 0; background: transparent; color: #586777; font-size: 28rpx; }
.collector-d1 .d1-story-tabs .d1-selected { color: #1e3d68; font-weight: 600; }
.d1-story-tabs .d1-selected::before { position: absolute; content: ""; height: 4rpx; width: 44rpx; left: calc(50% - 22rpx); bottom: 8rpx; border-radius: 4rpx; background: #e6783c; }
.collector-d1 .d1-filter .filter-search { background: #fff; min-height: 88rpx; margin: 0 0 10rpx; padding: 0 16rpx; }
.collector-d1 .d1-filter input { background: transparent; margin: 0; font-size: 28rpx; }
.collector-d1 .d1-filter .filter-chip { justify-content: center; box-sizing: border-box; border-radius: 16rpx; padding: 0 4rpx; }
.collector-d1 .d1-station { width: 100%; justify-content: flex-start; gap: 16rpx; padding: 16rpx; text-align: left; }
.collector-d1 .d1-station .site-thumb { width: 102rpx; height: 102rpx; }
.d1-station-rate { flex-wrap: wrap; }
.collector-d1 .d1-station .price { font-size: 38rpx; }
.d1-order-card .action { margin-top: 6rpx; }
.d1-profile-head { margin: -12rpx -28rpx 0; padding: 12rpx 28rpx 22rpx; background: linear-gradient(156deg,#e2eaf5,#f6f5f2); }
.d1-profile-id { gap: 16rpx; padding: 12rpx 0; }
.d1-profile-id .subheading { font-size: 44rpx; line-height: 58rpx; }
.d1-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #f8fbff; border: 1rpx solid #d9e1eb; font-size: 40rpx; font-weight: 600; }
.collector-d1 .d1-profile-orders { padding: 4rpx 20rpx 12rpx; }
.d1-order-tabs { display: flex; gap: 4rpx; }
.collector-d1 .d1-order-tabs button { flex: 1; min-width: 0; min-height: 100rpx; padding: 8rpx 0; flex-direction: column; gap: 6rpx; background: transparent; color: #4d5c6d; font-size: 24rpx; white-space: nowrap; }
.d1-order-icon { position: relative; }
.d1-count { position: absolute; top: -8rpx; right: -18rpx; min-width: 26rpx; padding: 0 4rpx; border-radius: 18rpx; background: #a64422; color: #fff; font-size: 19rpx; line-height: 29rpx; }
.collector-d1 .d1-profile-group { padding: 0 24rpx; }
