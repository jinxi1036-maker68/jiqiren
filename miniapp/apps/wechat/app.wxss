page {
  background: #f3f4ef;
  color: #172323;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.45;
}
.screen { padding: 22rpx 28rpx calc(36rpx + env(safe-area-inset-bottom)); }
.with-dock { padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.kicker { color: #526758; font-size: 22rpx; font-weight: 650; letter-spacing: 1rpx; }
.title { font-size: 48rpx; font-weight: 750; line-height: 1.16; margin: 10rpx 0 14rpx; }
.heading { font-size: 34rpx; font-weight: 730; line-height: 1.23; }
.subheading { font-size: 29rpx; font-weight: 720; line-height: 1.3; }
.muted { color: #59665e; font-size: 24rpx; }
.small { font-size: 22rpx; }
.section { margin: 30rpx 0 16rpx; }
.panel { background: #fff; border: 1rpx solid #e3e7dd; border-radius: 28rpx; padding: 24rpx; margin-bottom: 16rpx; }
.hero { color: #f6faed; background: #192d2b; padding: 30rpx 26rpx; border-radius: 32rpx; margin: 18rpx 0; }
.hero .muted, .hero .kicker { color: #c4d2be; }
.row { display: flex; align-items: center; gap: 12rpx; }
.split { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.badge { display: inline-block; background: #eaf1df; color: #344f37; padding: 6rpx 14rpx; border-radius: 40rpx; font-size: 22rpx; font-weight: 640; flex-shrink: 0; }
.badge-muted { background: #eff1eb; color: #5d6961; }
.notice { padding: 16rpx 18rpx; background: #f6f1df; color: #5f4a29; border-radius: 18rpx; margin: 14rpx 0; font-size: 24rpx; }
.divider { border-top: 1rpx solid #edf0e8; padding-top: 16rpx; margin-top: 16rpx; }
.link { color: #315334; font-weight: 650; padding: 10rpx 0; }
button { margin: 0; padding: 0 18rpx; border-radius: 18rpx; font-size: 26rpx; line-height: 1.25; min-height: 76rpx; background: #eef2e8; color: #263c2c; display: flex; align-items: center; justify-content: center; }
button::after { border: 0; }
button[disabled] { color: #68726b; background: #edf0e9; }
.primary { background: #d6f46d; color: #1b281e; font-weight: 720; }
.primary[disabled] { background: #e9ede2; color: #657061; }
.ghost { background: transparent; border: 1rpx solid #d9e0d4; }
.danger { background: #f8ebe4; color: #793b2b; }
.action { margin-top: 16rpx; }
.field, input, textarea { box-sizing: border-box; background: #f3f5f0; border: 1rpx solid #e1e6da; padding: 16rpx; border-radius: 16rpx; margin: 8rpx 0 16rpx; width: 100%; }
input { height: 76rpx; }
textarea { height: 138rpx; }
.tabs { margin: 18rpx 0; }
.tabs button { flex: 1; padding: 0 8rpx; }
.metric { font-size: 44rpx; font-weight: 740; line-height: 1.14; font-variant-numeric: tabular-nums; }
.tile { align-self: stretch; background: #f3f5ed; border-radius: 20rpx; padding: 16rpx; }
.illustration { display: block; width: 100%; height: 244rpx; border-radius: 22rpx; margin: 14rpx 0; background: #e7ecdd; }
.tagline { margin-top: 26rpx; color: #687367; text-align: center; font-size: 22rpx; }
.icon { width: 36rpx; height: 36rpx; flex-shrink: 0; display: block; }
.icon-small { width: 30rpx; height: 30rpx; }
.icon-chip { width: 86rpx; height: 86rpx; flex-shrink: 0; background: #e9efdc; border-radius: 25rpx; display: flex; align-items: center; justify-content: center; }
.icon-chip-lime { background: #dcf0a9; }
.chevron { width: 50rpx; height: 50rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f3e9; color: #2c472f; font-size: 34rpx; flex-shrink: 0; }
.subtle-button { min-height: 62rpx; padding: 0 16rpx; font-size: 23rpx; border-radius: 36rpx; }
.dock {
  position: fixed;
  z-index: 3;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #e2e6db;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 30rpx rgba(25, 45, 43, .05);
}
.dock-nav { display: flex; justify-content: space-around; gap: 4rpx; }
.dock-item { min-height: 88rpx; flex: 1; min-width: 0; background: transparent; color: #606c62; display: flex; flex-direction: column; gap: 3rpx; font-size: 21rpx; padding: 2rpx 4rpx; }
.dock-mark { position: relative; width: 72rpx; height: 48rpx; border-radius: 30rpx; display: flex; align-items: center; justify-content: center; }
.dock-item.is-active { color: #24382b; font-weight: 740; }
.dock-item.is-active .dock-mark { background: #e5f1c7; }
.unread-dot { position: absolute; top: -5rpx; right: -8rpx; color: #fff; background: #a24331; border-radius: 20rpx; min-width: 25rpx; padding: 2rpx 5rpx; text-align: center; font-size: 17rpx; }
.action-dock { display: flex; align-items: center; gap: 20rpx; min-height: 76rpx; }
.action-dock button { flex: 1; min-height: 78rpx; padding: 0 20rpx; }
.dock-summary { flex-shrink: 0; max-width: 46%; }
.dock-summary .subheading { font-size: 26rpx; }
.price { font-size: 38rpx; font-weight: 760; line-height: 1.1; letter-spacing: -.5rpx; color: #264c36; font-variant-numeric: tabular-nums; }
.price-unit { font-size: 21rpx; font-weight: 540; color: #657268; margin-left: 4rpx; letter-spacing: 0; }
.eyebrow { color: #576c5b; font-size: 23rpx; font-weight: 680; letter-spacing: 1rpx; }
.stage-grid { display: flex; align-items: stretch; gap: 10rpx; margin-top: 22rpx; }
.stage-item { flex: 1; min-width: 0; color: #687569; text-align: center; font-size: 20rpx; }
.stage-bar { height: 7rpx; border-radius: 12rpx; margin-bottom: 9rpx; background: #e6e9e0; }
.stage-current { color: #233b2a; font-weight: 740; }
.stage-current .stage-bar { background: #9bc44c; }
.stage-past .stage-bar { background: #bdcfaa; }
.hero .stage-item { color: #b9c9bb; }
.hero .stage-current { color: #e0f6a1; }
.hero .stage-bar { background: #38524a; }
.hero .stage-past .stage-bar { background: #789d78; }
.hero .stage-current .stage-bar { background: #d6f46d; }
.entry-brand { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.brand-lockup { gap: 12rpx; font-size: 28rpx; font-weight: 740; }
.brand-logo { width: 52rpx; height: 52rpx; border-radius: 17rpx; background: #203832; color: #dbf68a; display: flex; align-items: center; justify-content: center; font-weight: 780; }
.entry-cover { position: relative; overflow: hidden; min-height: 342rpx; box-sizing: border-box; padding: 35rpx 28rpx; border-radius: 32rpx; background: #172c2a; color: #fbfff1; }
.cover-art { position: absolute; bottom: -24rpx; right: -78rpx; width: 620rpx; height: 344rpx; opacity: .97; }
.cover-copy { position: relative; z-index: 1; }
.cover-label { color: #d4ef8b; letter-spacing: 3rpx; font-size: 20rpx; font-weight: 700; }
.cover-title { font-size: 58rpx; font-weight: 760; line-height: 1.08; margin: 20rpx 0 14rpx; }
.cover-description { max-width: 340rpx; font-size: 24rpx; color: #dfebd9; }
.entry-choice { display: flex; gap: 18rpx; justify-content: flex-start; min-height: 148rpx; background: #fff; border: 1rpx solid #e3e7dd; border-radius: 28rpx; padding: 20rpx; margin-bottom: 14rpx; text-align: left; }
.entry-choice .muted { line-height: 1.4; margin-top: 8rpx; display: block; }
.entry-choice .subheading { font-size: 32rpx; }
.entry-footer { text-align: center; margin: 22rpx 0 8rpx; }
.entry-footer button { margin: 6rpx auto 0; padding: 0 16rpx; min-height: 62rpx; background: transparent; font-size: 23rpx; color: #556359; }
.list-masthead { margin-bottom: 18rpx; }
.list-masthead .title { margin-bottom: 8rpx; }
.city-mark { font-size: 25rpx; font-weight: 740; }
.filter-panel { padding: 16rpx 20rpx; }
.filter-search { margin: 0 0 12rpx; background: #f1f3ed; }
.filter-search input { margin: 0; border: 0; padding-left: 0; }
.filter-chip { display: flex; align-items: center; min-height: 58rpx; padding: 0 13rpx; border-radius: 13rpx; background: #f5f6f1; color: #3d4a40; font-size: 23rpx; white-space: nowrap; }
.filter-row { gap: 8rpx; }
.filter-row picker { flex: 1; min-width: 0; }
.site-card { padding: 19rpx 20rpx; }
.site-thumb { width: 128rpx; height: 128rpx; border-radius: 20rpx; flex-shrink: 0; background: #e8eddf; }
.site-name { font-size: 31rpx; font-weight: 750; line-height: 1.2; margin: 7rpx 0; }
.site-card .row:first-child { align-items: flex-start; }
.site-card .subtle-button { min-width: 156rpx; }
.availability { display: inline-flex; align-items: center; gap: 7rpx; color: #3a5538; font-size: 22rpx; font-weight: 660; }
.availability-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #78a65a; flex-shrink: 0; }
.availability-closed { color: #626d62; }
.availability-closed .availability-dot { background: #a3aca0; }
.scene-panel { overflow: hidden; padding: 0; }
.scene-cover { display: block; width: 100%; height: 262rpx; background: #e7ecdd; }
.scene-info { padding: 22rpx 24rpx 24rpx; }
.scene-info .title { font-size: 42rpx; margin-top: 11rpx; }
.scene-meta { margin-top: 20rpx; }
.scene-meta .tile { padding: 13rpx 16rpx; }
.slot-scroll { width: 100%; margin-top: 12rpx; }
.slot-row { display: flex; width: max-content; gap: 9rpx; }
.slot { flex-shrink: 0; min-height: 68rpx; min-width: 100rpx; border: 1rpx solid #e0e6d9; background: #f6f7f2; color: #304434; font-size: 24rpx; }
.slot-selected { border-color: #9fbd72; background: #e5f2c6; font-weight: 760; }
.sop-row { align-items: flex-start; gap: 14rpx; }
.sop-step { min-width: 46rpx; height: 46rpx; border-radius: 16rpx; background: #ecf3de; color: #405a36; text-align: center; line-height: 46rpx; font-size: 22rpx; font-weight: 730; flex-shrink: 0; }
.merchant-action { background: #e8f1d6; }
.merchant-next { font-size: 37rpx; font-weight: 750; margin: 8rpx 0; }
.photo-choice { min-height: 114rpx; flex-direction: column; font-size: 23rpx; gap: 6rpx; padding: 10rpx 4rpx; }
.photo-sign { font-size: 33rpx; line-height: 1; font-weight: 700; }
.money-line { font-variant-numeric: tabular-nums; font-weight: 720; }
